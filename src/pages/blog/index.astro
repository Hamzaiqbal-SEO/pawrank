---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import CTABanner from '../../components/CTABanner.astro';

const posts = [
  {
    title: "Veterinary SEO: The Complete Guide to Get More Clients",
    slug: "veterinary-seo-guide",
    excerpt: "Everything you need to know about SEO for veterinary clinics — from Google Business Profile optimization to content strategy, technical SEO, and reputation management.",
    image: "/images/Veterinary-seo-guide.webp",
    date: "March 18, 2026",
    readTime: "25 min read",
    category: "SEO Guide",
  },
];
---

<BaseLayout
  title="Veterinary SEO Blog – Expert Guides & Tips | Paw Rank"
  description="Expert veterinary SEO guides, tips, and strategies to help your clinic rank higher, attract more pet owners, and fill your appointment book."
>
  <Hero
    eyebrow="Blog"
    title="Veterinary SEO<br/>Insights & Guides"
    subtitle="Expert strategies, actionable tips, and data-driven insights to help your veterinary practice dominate local search."
  />

  <section class="section section--chalk">
    <div class="container">
      <div class="blog-grid">
        {posts.map((post) => (
          <a href={`/blog/${post.slug}/`} class="blog-card reveal">
            <div class="blog-card-image">
              <img src={post.image} alt={post.title} loading="lazy" />
              <span class="blog-card-category">{post.category}</span>
            </div>
            <div class="blog-card-content">
              <div class="blog-card-meta">
                <span>{post.date}</span>
                <span>•</span>
                <span>{post.readTime}</span>
              </div>
              <h3 class="blog-card-title">{post.title}</h3>
              <p class="blog-card-excerpt">{post.excerpt}</p>
              <span class="blog-card-link">Read the full guide →</span>
            </div>
          </a>
        ))}
      </div>

      <div class="blog-more reveal">
        <p>More guides and articles are on the way. Stay tuned!</p>
      </div>
    </div>
  </section>

  <CTABanner
    title="Want Personalized SEO Advice for Your Clinic?"
    subtitle="Our blog covers general strategies, but your practice is unique. Book a free call for a tailored analysis."
    primaryCta={{ label: "Book a Free Consultation", href: "/contact/#calendly" }}
  />
</BaseLayout>

<style>
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(380px, 1fr));
    gap: 32px;
    max-width: 900px;
    margin: 0 auto;
  }

  .blog-card {
    background: var(--pr-white);
    border: 1px solid var(--pr-border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    transition: all var(--transition-base);
    display: flex;
    flex-direction: column;
    text-decoration: none;
  }

  .blog-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-card-hover);
    border-color: rgba(50, 92, 232, 0.15);
  }

  .blog-card-image {
    position: relative;
    aspect-ratio: 16/9;
    overflow: hidden;
  }

  .blog-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .blog-card:hover .blog-card-image img {
    transform: scale(1.05);
  }

  .blog-card-category {
    position: absolute;
    top: 16px;
    left: 16px;
    padding: 4px 12px;
    background: var(--pr-blue);
    color: var(--pr-white);
    border-radius: var(--radius-pill);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .blog-card-content {
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 1;
  }

  .blog-card-meta {
    display: flex;
    gap: 8px;
    font-size: 13px;
    color: var(--pr-text);
  }

  .blog-card-title {
    font-size: 22px;
    color: var(--pr-navy);
    line-height: 1.3;
  }

  .blog-card-excerpt {
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--pr-text);
    flex: 1;
  }

  .blog-card-link {
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 700;
    color: var(--pr-blue);
    transition: color 0.2s;
  }

  .blog-card:hover .blog-card-link {
    color: var(--pr-blue-hover);
  }

  .blog-more {
    text-align: center;
    margin-top: 48px;
    padding: 32px;
    background: var(--pr-white);
    border-radius: var(--radius-lg);
    border: 1px dashed var(--pr-border-dark);
  }

  .blog-more p {
    font-size: 15px;
    color: var(--pr-text);
  }

  @media (max-width: 500px) {
    .blog-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
