---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import FeatureCard from '../components/FeatureCard.astro';
import ProcessTimeline from '../components/ProcessTimeline.astro';
import StatsBar from '../components/StatsBar.astro';
import UKROICalculator from '../components/UKROICalculator.astro';
import FAQ from '../components/FAQ.astro';
import CTABanner from '../components/CTABanner.astro';

// SVG Icons
const icons = {
  search: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>`,
  mapPin: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>`,
  star: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>`,
  building: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="2" width="16" height="20" rx="2" ry="2"/><line x1="9" y1="22" x2="9" y2="22.01"/><line x1="15" y1="22" x2="15" y2="22.01"/><line x1="9" y1="6" x2="9" y2="6.01"/><line x1="15" y1="6" x2="15" y2="6.01"/><line x1="9" y1="10" x2="9" y2="10.01"/><line x1="15" y1="10" x2="15" y2="10.01"/><line x1="9" y1="14" x2="9" y2="14.01"/><line x1="15" y1="14" x2="15" y2="14.01"/><line x1="9" y1="18" x2="9" y2="18.01"/><line x1="15" y1="18" x2="15" y2="18.01"/></svg>`,
  trendUp: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>`,
  clinic: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2z"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>`,
  target: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>`,
  chart: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>`,
  paw: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="17" rx="3.5" ry="2.5"/><ellipse cx="7" cy="11.5" rx="1.5" ry="2.2" transform="rotate(-15 7 11.5)"/><ellipse cx="17" cy="11.5" rx="1.5" ry="2.2" transform="rotate(15 17 11.5)"/><ellipse cx="10" cy="8.5" rx="1.5" ry="2.2"/><ellipse cx="14" cy="8.5" rx="1.5" ry="2.2"/></svg>`,
  shield: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
  check: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>`,
  calendar: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>`,
  bot: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="10" rx="2"/><circle cx="12" cy="5" r="2"/><path d="M12 7v4"/><line x1="8" y1="16" x2="8.01" y2="16"/><line x1="16" y1="16" x2="16.01" y2="16"/></svg>`,
  phone: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>`,
  users: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
};

// 4-Step Methodology
const ukProcessSteps = [
  { 
    number: "01", 
    title: "UK Catchment & Competitor Audit", 
    description: "We audit your local 5-mile radius, evaluate corporate rivals (CVS, IVC, Medivet), analyse Google 3-Pack rankings, and identify high-value search queries pet owners use in your UK county or borough." 
  },
  { 
    number: "02", 
    title: "Google 3-Pack & Local Citation Sync", 
    description: "We re-architect your Google Business Profile, align veterinary categories, eliminate NAP inconsistencies across Yell, Scoot, 118, and Thomson Local, and build geo-relevance around your physical practice." 
  },
  { 
    number: "03", 
    title: "Clinical Authority & Reviews Engine", 
    description: "We publish RCVS-compliant clinical content targeting laparoscopic spays, dental care, and emergency terms while deploying automated post-consultation review requests to hit 100+ Google reviews." 
  },
  { 
    number: "04", 
    title: "Conversion Tracking & Monthly Refinement", 
    description: "We connect call tracking, appointment booking events (Vetstoria/PetsApp), and Google Analytics 4. You receive transparent monthly reports showing registered pets and revenue impact—zero vanity metrics." 
  },
];

// UK Market Statistics Table Data
const ukMarketStats = [
  { metric: "UK Veterinary Market Size", value: "£4.5 Billion", source: "IBISWorld & CMA Veterinary Study", note: "Rapidly expanding market with high owner spend" },
  { metric: "Registered Veterinary Practices", value: "5,200+ Premises", source: "RCVS Practice Standards Scheme", note: "Across England, Scotland, Wales & Northern Ireland" },
  { metric: "UK Companion Pet Population", value: "34 Million Pets", source: "PDSA Animal Wellbeing (PAW) Report", note: "13.5M dogs, 12.5M cats, plus small furries & exotics" },
  { metric: "Pet Owners Searching Online First", value: "70%", source: "UK Digital Health Consumer Survey", note: "Owners consult Google before booking or choosing a vet" },
  { metric: "'Vet Near Me' Monthly UK Searches", value: "135,000+ Searches/Mo", source: "Google Keyword Planner (UK Aggregate)", note: "Consistently the highest-intent local healthcare query" },
  { metric: "Corporate Clinic Ownership", value: "~60% of All Practices", source: "CMA Market Investigation (2024–2026)", note: "Dominated by 6 major groups (IVC, CVS, Medivet, Linnaeus)" },
  { metric: "Corporate vs Independent Marketing Spend", value: "5–8% vs 2–4% of Turnover", source: "UK Veterinary Financial Benchmarks", note: "Independents feel outspent; require trust-led SEO" },
  { metric: "100+ Google Reviews Growth Multiplier", value: "3.5× More Registrations", source: "Veterinary Local SEO Benchmarks", note: "Practices with 100+ reviews vs those with under 20" },
  { metric: "Younger Pet Owner Churn Rate (18–34)", value: "48% Likely to Switch", source: "PDSA & Consumer Health Data", note: "Digitally native pet owners switch when booking is slow" },
  { metric: "Appointment Booking Friction", value: "38% Abandon Telephone", source: "Vetstoria Pet Owner Experience Report", note: "27% of UK pet owners strictly prefer online self-booking" },
  { metric: "Average Pet Lifetime Healthcare Value", value: "£10,000 – £20,000", source: "Association of British Insurers & PDSA", note: "Lifetime care spend per companion dog or cat" },
];

// Regional Search Benchmarks
const regionalBenchmarks = [
  { region: "Greater London & M25", monthlySearches: "34,500+", avgCompetition: "Very High", avgReviewsTop3: "148 reviews", keyGrowthTerm: "'24 hour vet London', 'cat clinic near me'" },
  { region: "South East & Home Counties", monthlySearches: "22,000+", avgCompetition: "High", avgReviewsTop3: "112 reviews", keyGrowthTerm: "'vet near me Surrey', 'laparoscopic dog spay'" },
  { region: "West Midlands & Birmingham", monthlySearches: "15,800+", avgCompetition: "High", avgReviewsTop3: "96 reviews", keyGrowthTerm: "'emergency vet Birmingham', 'rabbit vet'" },
  { region: "Greater Manchester & North West", monthlySearches: "17,400+", avgCompetition: "High", avgReviewsTop3: "104 reviews", keyGrowthTerm: "'vet near me Manchester', 'pet dental surgery'" },
  { region: "Yorkshire & Humber (Leeds/Sheffield)", monthlySearches: "12,200+", avgCompetition: "Medium-High", avgReviewsTop3: "82 reviews", keyGrowthTerm: "'independent vet Leeds', 'exotic vet near me'" },
  { region: "Scotland (Edinburgh & Glasgow)", monthlySearches: "13,600+", avgCompetition: "Medium-High", avgReviewsTop3: "89 reviews", keyGrowthTerm: "'vet clinic Glasgow', 'emergency vet Edinburgh'" },
  { region: "South West (Bristol, Bath, Devon)", monthlySearches: "10,900+", avgCompetition: "Medium", avgReviewsTop3: "76 reviews", keyGrowthTerm: "'vet Bristol', 'cattery and vet near me'" },
];

// Software & Product Tool Stack
const toolStack = [
  {
    name: "Google Business Profile",
    category: "Foundational / Local Pack",
    desc: "The primary driver of the Google Local 3-Pack and Google Maps. We optimize secondary clinical categories, opening hours, emergency attributes, geo-tagged clinical imagery, and Google Posts.",
    badge: "Essential"
  },
  {
    name: "Google Search Console & GA4",
    category: "Analytics & Organic Tracking",
    desc: "Provides unfiltered data on actual search queries, click-through rates, mobile performance, and conversion tracking across phone calls and online registration forms.",
    badge: "Essential"
  },
  {
    name: "Semrush & Ahrefs",
    category: "Market & Keyword Intelligence",
    desc: "Industry-standard SEO software used to track local keyword movements, analyze competitor backlinks from local UK news and pet associations, and identify untapped clinical searches.",
    badge: "Professional"
  },
  {
    name: "BrightLocal & Whitespark",
    category: "Citation & Geo-Grid Rank Tracking",
    desc: "Audits and standardizes your practice Name, Address, and Phone number (NAP) across authoritative UK directories like Yell, 118, Scoot, and Thomson Local. Pinpoints map rankings down to the postcode.",
    badge: "Professional"
  },
  {
    name: "Podium & Birdeye",
    category: "Reviews & Reputation Engine",
    desc: "Automates friendly SMS and email review invitations directly following clinical appointments, helping your practice cross the decisive 100+ review threshold to unlock the 3.5× registration effect.",
    badge: "Reputation"
  },
  {
    name: "Vetstoria & Digital Booking",
    category: "Conversion Rate Optimization (CRO)",
    desc: "Connects your website directly into your Practice Management System (RoboVet, Merlin, Teleos). Captures the 27% of UK owners who demand instant digital booking and eliminates 38% telephone booking friction.",
    badge: "Conversion"
  }
];

// FAQs for UK Practice Owners
const ukFaqItems = [
  { 
    question: "Why should a UK veterinary practice choose a vet-specialized SEO agency over a general marketing agency?", 
    answer: "Veterinary search is unlike any other local business. Pet owners make decisions under acute emotional stress, search patterns differ drastically between routine preventive care and emergency queries, and marketing must strictly adhere to the Royal College of Veterinary Surgeons (RCVS) Code of Professional Conduct. General marketing agencies do not understand clinical keyword hierarchies, local catchment geometry, or practice management integrations like Vetstoria. Paw Rank is 100% dedicated to veterinary medicine—we speak your language and understand your caseload." 
  },
  { 
    question: "How can independent UK practices outrank corporate veterinary consolidators?", 
    answer: "Around 60% of UK practices are owned by corporate groups (CVS, IVC Evidensia, Linnaeus, Medivet, Vets4Pets) with huge 5–8% marketing budgets. However, corporate groups rely on centralized, generic website templates that lack local authenticity and suffer from high staff turnover. Google's Local algorithm prioritizes local relevance, proximity, authentic patient reviews, and clinician E-E-A-T. By building real clinical authority, showcasing named surgeons, and collecting authentic local reviews, an independent practice can consistently outrank corporate clinics in the Google 3-Pack without matching their multimillion-pound advertising spend." 
  },
  { 
    question: "How long does it take for a UK veterinary clinic to see results in local search?", 
    answer: "Most practices experience measurable improvements in local pack impressions and Google Business Profile actions within 60 to 90 days. Foundation technical fixes, NAP directory synchronization, and profile category corrections yield rapid initial gains. Broader organic rankings for competitive procedures (such as pet laparoscopic spays or dental procedures) compound steadily between months 3 and 6 as domain authority grows." 
  },
  { 
    question: "What is the business case for veterinary SEO based on pet lifetime care value?", 
    answer: "According to the PDSA PAW Report and the Association of British Insurers, the lifetime care spend of a companion dog or cat ranges between £10,000 and £20,000 across routine consultations, vaccinations, preventative health schemes, diagnostics, dental cleanings, and surgical interventions. Gaining just 5 to 10 additional new client registrations each month translates to £50,000–£100,000 in immediate annual revenue and adds over £1,000,000 in long-term practice equity value. Veterinary SEO delivers an ROI that far exceeds paid Google Ads." 
  },
  { 
    question: "How does your review strategy achieve the '3.5x registration effect' without violating RCVS rules?", 
    answer: "Market data demonstrates that UK practices with 100+ authentic Google reviews receive 3.5× more new client registrations than competitors with under 20 reviews. We deploy automated, ethical post-consultation SMS and email prompts via review management platforms (such as Podium or Birdeye). Our systems strictly follow RCVS guidelines: we never offer financial inducements or incentivize reviews. Instead, we make it effortless for delighted pet owners to share genuine feedback." 
  },
  { 
    question: "How do you optimize our practice for AI search tools like ChatGPT and Google AI Overviews?", 
    answer: "AI search engines synthesize direct answers using Generative Engine Optimization (GEO). We structure your website using advanced Veterinary Schema (LocalBusiness, MedicalClinic, openingHours, geoCoordinates), clear clinical question-and-answer formatting, and verifiable author credentials. When pet owners ask ChatGPT or Google AI 'Who is the best cat-friendly clinic in Surrey?', your clinic is cited as the definitive local authority." 
  },
  { 
    question: "Do you require long-term lock-in contracts?", 
    answer: "No. All our veterinary SEO partnerships operate on a flexible 30-day rolling agreement. We believe in earning our place as your practice's growth partner every single month through measurable increases in booked appointments and registered patients." 
  },
  { 
    question: "What is included in your Free UK Veterinary SEO Audit?", 
    answer: "Our audit is a custom, manual analysis of your practice's digital presence. We examine your Google Local 3-Pack rank across your 5-mile catchment, compare your review velocity against corporate competitors, test your website's mobile Core Web Vitals speed, audit online booking friction, and identify the top 20 missing veterinary keywords in your UK area. It is 100% free with zero obligation." 
  },
  { 
    question: "Can you support veterinary practices with multiple branch surgeries?", 
    answer: "Yes. Multi-site practices face unique challenges with keyword cannibalization and Google Maps overlap. We create dedicated, hyper-optimized location landing pages for each branch surgery, synchronize separate Google Business Profiles, and ensure consistent citations across all UK directories so every location dominates its immediate local radius." 
  },
];
---

<BaseLayout
  title="Veterinary SEO Agency UK | SEO Services for Vets That Win Local Searches"
  description="Paw Rank is the specialist UK veterinary SEO agency. We help independent vet practices dominate 'vet near me' local searches, outrank corporate clinics, and fill appointment books."
  canonical="https://pawrank.com/uk-homepage-v2"
>
  <!-- JSON-LD Structured Data for AI & Search Engines -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "ProfessionalService",
        "@id": "https://pawrank.com/#agency",
        "name": "Paw Rank UK - Veterinary SEO Agency",
        "url": "https://pawrank.com/uk-homepage",
        "logo": "https://pawrank.com/images/Pawrank-Logo.png",
        "image": "https://pawrank.com/images/pawrank-cover.png",
        "description": "Specialist UK Veterinary SEO Agency helping independent vet clinics win 'vet near me' searches, outrank corporate consolidators, and drive appointment bookings.",
        "email": "pawrankofficial@gmail.com",
        "address": {
          "@type": "PostalAddress",
          "addressCountry": "GB"
        },
        "areaServed": "United Kingdom",
        "priceRange": "££",
        "knowsAbout": [
          "Veterinary SEO",
          "Veterinary Local SEO",
          "Google Business Profile for Vet Clinics",
          "Veterinary Reputation Management",
          "Vetstoria Online Booking Optimization",
          "RCVS Advertising Compliance"
        ]
      },
      {
        "@type": "FAQPage",
        "@id": "https://pawrank.com/uk-homepage#faq",
        "mainEntity": ukFaqItems.map(item => ({
          "@type": "Question",
          "name": item.question,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": item.answer
          }
        }))
      }
    ]
  })} />

  <!-- HERO SECTION -->
  <Hero
    eyebrow="Specialist Veterinary SEO Agency UK"
    title="Veterinary SEO Agency Helping UK Practices Win More Local Clients"
    subtitle="We help independent UK veterinary practices dominate local search, strengthen their online visibility, and become the trusted choice for pet owners searching for veterinary care."
    primaryCta={{ label: "Request Your Free Visibility Audit", href: "#free-audit" }}
    secondaryCta={{ label: "ROI Calculator", href: "#uk-vet-roi-calculator" }}
  />

  <!-- QUICK STATS BAR -->
  <section class="section section--white" style="padding-top: 24px; padding-bottom: 24px; border-bottom: 1px solid var(--pr-border);">
    <StatsBar stats={[
      { value: "135,000+", label: "Monthly UK 'Vet Near Me' Searches" },
      { value: "3.5×", label: "Client Registrations With 100+ Reviews" },
      { value: "£10k–£20k", label: "Lifetime Value Per Registered Pet" },
      { value: "100%", label: "Veterinary Industry Focus" },
    ]} />
  </section>

  <!-- THE UK VETERINARY MARKET DILEMMA (PROBLEM STATEMENT) -->
  <section class="section section--chalk">
    <div class="container">
      <SectionHeading
        eyebrow="UK Veterinary Market Analysis"
        title="Why Independent UK Practices Feel Outspent in Local Search"
        subtitle="The UK veterinary landscape has changed dramatically. Understanding the numbers is the first step to reclaiming your local market."
      />

      <div class="split-section">
        <div class="split-content reveal">
          <span class="eyebrow eyebrow--blue">Market Reality</span>
          <h2>The Battle for Your 5-Mile Catchment Area</h2>
          <p class="text-lead">
            Across the UK, <strong>5,200+ veterinary surgeries</strong> compete for <strong>34 million companion pets</strong> in a <strong>£4.5 billion market</strong>. But the playing field is no longer balanced.
          </p>
          <p>
            Around <strong>60% of UK veterinary practices</strong> are now owned by corporate consolidators—including CVS Group, IVC Evidensia, Linnaeus, Medivet, and Vets4Pets. Corporate chains deploy <strong>5% to 8% of revenue</strong> into centralized digital marketing, outspending independent practices who traditionally invest only 2% to 4%.
          </p>
          <p>
            When a local pet owner's dog displays sudden lethargy or needs a vaccination, they turn to Google. <strong>135,000+ monthly searches</strong> in the UK query <em>"vet near me"</em> or location-specific terms like <em>"independent vet Edinburgh"</em> or <em>"emergency vet Birmingham"</em>. If your clinic does not appear in the top 3 Google Maps positions, corporate clinics win those new pet registrations by default.
          </p>
          <div class="quote-box">
            <p>
              <em>"Practices with 100+ authentic Google reviews see 3.5× more new client registrations than those with fewer than 20. Digital visibility is no longer an afterthought—it is the lifeline of practice independence."</em>
            </p>
          </div>
        </div>

        <div class="split-visual reveal reveal-delay-2">
          <div class="pain-points-card">
            <h3>Key Challenges Facing UK Vet Practices</h3>
            <ul class="pain-points-list">
              <li>
                <div class="pain-icon" set:html={icons.mapPin} />
                <div>
                  <strong>Invisible in the Local 3-Pack:</strong>
                  <span>Losing local visibility for high-volume 'vet near me' and emergency terms despite serving the community for years.</span>
                </div>
              </li>
              <li>
                <div class="pain-icon" set:html={icons.building} />
                <div>
                  <strong>Corporate Budget Disadvantage:</strong>
                  <span>Struggling to compete with corporate chains spending hundreds of thousands on ads and centralized marketing teams.</span>
                </div>
              </li>
              <li>
                <div class="pain-icon" set:html={icons.star} />
                <div>
                  <strong>Review Starvation:</strong>
                  <span>Fewer than 50 Google reviews leaves pet owners hesitant, even when clinical care is exceptional.</span>
                </div>
              </li>
              <li>
                <div class="pain-icon" set:html={icons.calendar} />
                <div>
                  <strong>Booking Friction & Churn:</strong>
                  <span>27% of UK pet owners prefer digital self-booking. Practices without integrated booking lose up to 48% of younger clients within a year.</span>
                </div>
              </li>
              <li>
                <div class="pain-icon" set:html={icons.bot} />
                <div>
                  <strong>Absent from AI Search:</strong>
                  <span>Not appearing when pet owners ask ChatGPT, Perplexity, or Google AI Overviews for veterinary recommendations in their town.</span>
                </div>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- THE INDEPENDENT PRACTICE ADVANTAGE -->
  <section class="section section--white">
    <div class="container">
      <SectionHeading
        eyebrow="The Independent Advantage"
        title="How Independent Vets Out-Trust Corporate Groups Without Outspending Them"
        subtitle="Corporate clinics have bigger budgets, but independent practices possess what pet owners value most: genuine trust, clinical continuity, and authentic community roots."
      />

      <div class="grid grid--3">
        <FeatureCard
          icon={icons.shield}
          title="Authentic E-E-A-T & Continuity"
          description="Pet owners dread seeing a different locum at every appointment. We highlight your permanent clinical team, veterinary surgeons, and registered veterinary nurses (RVNs) to build profound owner trust."
          delay={1}
        />
        <FeatureCard
          icon={icons.star}
          title="Reviews-First Local SEO"
          description="We lead with review velocity. Reaching 100+ glowing, authentic Google reviews generates a 3.5× multiplier in client registrations that corporate automated marketing cannot fake."
          delay={2}
        />
        <FeatureCard
          icon={icons.target}
          title="Hyper-Local Postcode Targeting"
          description="We don't waste budget on broad county keywords. We optimize for high-intent pet owners within your exact 3-to-7 mile radius, targeting village, suburb, and borough search intent."
          delay={3}
        />
        <FeatureCard
          icon={icons.clinic}
          title="High-Value Clinical Procedures"
          description="Generalist agencies only rank for 'vet'. We capture lucrative, high-margin caseloads: laparoscopic keyhole spays, dental extractions, orthopaedic consults, and ultrasound scans."
          delay={1}
        />
        <FeatureCard
          icon={icons.calendar}
          title="Frictionless Booking Integration"
          description="We integrate tools like Vetstoria directly with your website to capture the 27% of pet owners who refuse to book via phone during clinical opening hours."
          delay={2}
        />
        <FeatureCard
          icon={icons.bot}
          title="AI Search & Generative Visibility"
          description="We structure your clinical data so AI models (ChatGPT, Google AI Overviews) cite your practice as the trusted, premier veterinary recommendation in your catchment."
          delay={3}
        />
      </div>
    </div>
  </section>

  <!-- SCANNABLE UK VETERINARY MARKET DATA TABLE -->
  <section class="section section--chalk" id="uk-market-data">
    <div class="container">
      <SectionHeading
        eyebrow="Verified Industry Data"
        title="UK Veterinary Market Statistics & Benchmarks"
        subtitle="Citable, authoritative data points from the CMA, RCVS, PDSA PAW Report, and IBISWorld illustrating digital opportunity in the UK."
      />

      <div class="table-wrapper reveal">
        <table class="market-table">
          <thead>
            <tr>
              <th>Market Metric</th>
              <th>UK Industry Value</th>
              <th>Primary Source</th>
              <th>Strategic Impact on Veterinary Practice SEO</th>
            </tr>
          </thead>
          <tbody>
