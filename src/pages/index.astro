---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import FeatureCard from '../components/FeatureCard.astro';
import ProcessTimeline from '../components/ProcessTimeline.astro';
import StatsBar from '../components/StatsBar.astro';
import ROICalculator from '../components/ROICalculator.astro';
import FAQ from '../components/FAQ.astro';
import CTABanner from '../components/CTABanner.astro';

// SVG Icons Definitions for Homepage
const icons = {
  search: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>`,
  mapPin: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>`,
  clock: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>`,
  star: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>`,
  building: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="2" width="16" height="20" rx="2" ry="2"/><line x1="9" y1="22" x2="9" y2="22.01"/><line x1="15" y1="22" x2="15" y2="22.01"/><line x1="9" y1="6" x2="9" y2="6.01"/><line x1="15" y1="6" x2="15" y2="6.01"/><line x1="9" y1="10" x2="9" y2="10.01"/><line x1="15" y1="10" x2="15" y2="10.01"/><line x1="9" y1="14" x2="9" y2="14.01"/><line x1="15" y1="14" x2="15" y2="14.01"/><line x1="9" y1="18" x2="9" y2="18.01"/><line x1="15" y1="18" x2="15" y2="18.01"/></svg>`,
  trendUp: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>`,
  clinic: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2z"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>`,
  target: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>`,
  chart: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>`,
  paw: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="17" rx="3.5" ry="2.5"/><ellipse cx="7" cy="11.5" rx="1.5" ry="2.2" transform="rotate(-15 7 11.5)"/><ellipse cx="17" cy="11.5" rx="1.5" ry="2.2" transform="rotate(15 17 11.5)"/><ellipse cx="10" cy="8.5" rx="1.5" ry="2.2"/><ellipse cx="14" cy="8.5" rx="1.5" ry="2.2"/></svg>`,
  partnership: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/></svg>`,
  book: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/><line x1="9" y1="7" x2="15" y2="7"/><line x1="9" y1="11" x2="15" y2="11"/></svg>`,
};

const processSteps = [
  { number: "01", title: "Discovery & Audit", description: "We deep-dive into your market, competitors, and current online presence to build a data-driven strategy." },
  { number: "02", title: "Foundation Build", description: "Technical SEO fixes, Google Business Profile optimization, and website health improvements." },
  { number: "03", title: "Growth Execution", description: "Content creation, local authority building, conversion optimization, and ongoing keyword targeting." },
  { number: "04", title: "Report & Refine", description: "Transparent monthly reporting, strategy calls, and continuous refinement based on real results." },
];

const whyCards = [
  { icon: icons.clinic, title: "Exclusively Veterinary", description: "We don't do SEO for restaurants or law firms. Our entire focus is the veterinary industry — we know your regulatory environment, patients, and competitors better than any generalist." },
  { icon: icons.target, title: "Hyper-Local Targeting", description: "We go beyond city-level SEO. Our geo-targeting strategies reach pet owners in specific neighborhoods within your service radius." },
  { icon: icons.chart, title: "Transparent ROI Reporting", description: "We show the direct link between our SEO work and new patient inquiries. Not vanity metrics — real appointment bookings." },
  { icon: icons.paw, title: "Patient-First Approach", description: "Everything we do is framed around connecting more pet owners with the best possible care. You focus on patients, we bring them to your door." },
  { icon: icons.partnership, title: "Long-Term Partnership", description: "We work as an extension of your team — learning your goals, adapting strategy as your practice evolves, and celebrating your growth." },
  { icon: icons.book, title: "Exclusive Resources", description: "Clients get access to private webinars and guides on maximizing your Google Business Profile and leveraging SEO results." },
];

const faqItems = [
  { question: "How long does it take to see results from veterinary SEO?", answer: "Most practices start seeing measurable improvements in local visibility within 3–6 months. SEO is a long-term investment — early wins like improved Google Business Profile rankings can come sooner, while broader organic growth builds steadily over time." },
  { question: "What makes veterinary SEO different from general SEO?", answer: "Veterinary SEO requires understanding of pet owner search behavior, local competition dynamics specific to the vet industry, regulatory considerations, and the types of services that drive the highest patient value. Generic agencies often miss these nuances." },
  { question: "Do I need to sign a long-term contract?", answer: "We believe in earning your trust month-to-month. While SEO works best as a sustained investment, we don't lock you into lengthy contracts. Our clients stay because they see results." },
  { question: "How do you measure success?", answer: "We track what matters: new patient calls, form submissions, appointment bookings, and your visibility for the specific services you want to grow. Rankings and traffic are reported too, but they're means to an end, not the goal." },
  { question: "I already have a website — do you redesign it?", answer: "Not necessarily. We assess your current website and optimize it for search performance and conversions. If a redesign would significantly improve results, we'll recommend it — but we work with what you have when it makes sense." },
];
---

<BaseLayout
  title="Veterinary SEO Services – Fill Your Appointment Book | Paw Rank"
  description="Struggling to fill appointments? Our vet-specialized SEO boosts local rankings, attracts more pet owners & drives new patient calls. Transparent results. Free Audit!"
>
  <!-- HERO -->
  <Hero
    eyebrow="Veterinary SEO Specialists"
    title="Get More Pet Owners with <br/>Veterinary SEO"
    subtitle="Show up on top of Google when local pet owners look for a vet. Grow your practice naturally without paying for ads or guessing what works."
    primaryCta={{ label: "Book a Free Consultation", href: "/contact/#calendly" }}
    secondaryCta={{ label: "VET SEO ROI Calculator", href: "#vet-seo-roi-calculator" }}
  />

  <!-- WHY SEO MATTERS -->
  <section class="section section--chalk">
    <div class="container">
      <SectionHeading
        eyebrow="The Problem"
        title="Why Does SEO Matter for Your Practice?"
        subtitle="If you're not showing up when pet owners search, they're going to your competitor."
      />

      <div class="grid grid--3">
        <FeatureCard
          icon={icons.search}
          title="Pet Owners Search Online First"
          description="Over 80% of consumers use search engines to find local businesses, including veterinary clinics. If you're not showing up, they're going to your competitor."
          delay={1}
        />
        <FeatureCard
          icon={icons.mapPin}
          title="Local Visibility Gaps"
          description="A great website means nothing if it doesn't appear when someone searches 'emergency vet near me' or 'cat specialist in your town.' Local SEO bridges that gap."
          delay={2}
        />
        <FeatureCard
          icon={icons.clock}
          title="No Time for DIY SEO"
          description="Your priority is animal welfare — not decoding algorithm updates or managing digital directories. That's where we come in."
          delay={3}
        />
        <FeatureCard
          icon={icons.star}
          title="Reviews Cost You Patients"
          description="A 3-star rating with an unanswered negative review is enough to send a potential client straight to your competitor. Your online reputation matters."
          delay={1}
        />
        <FeatureCard
          icon={icons.building}
          title="Corporate Clinics Outspend You"
          description="Larger veterinary groups have dedicated marketing teams and big budgets. Independent practices need a smarter, more focused strategy to compete."
          delay={2}
        />
        <FeatureCard
          icon={icons.trendUp}
          title="SEO Compounds Over Time"
          description="Unlike paid ads that stop when you stop paying, SEO builds lasting visibility that compounds month after month, delivering sustainable growth."
          delay={3}
        />
      </div>
    </div>
  </section>

  <!-- WHAT IS VET SEO -->
  <section class="section section--white">
    <div class="container">
      <div class="split-section">
        <div class="split-content reveal">
          <span class="eyebrow eyebrow--blue">More Than Keywords</span>
          <h2>What Is Veterinary SEO?</h2>
          <p class="text-lead">
            Veterinary SEO is the strategic process of optimizing your entire online presence — your website, Google Business Profile, directories, and content — so that local pet owners find your clinic when they need you most.
          </p>
          <p>
            We don't just chase rankings. We build an inviting, trustworthy, and informative online presence that mirrors the quality and compassion of your physical clinic — making it easy for pet owners to choose you with confidence.
          </p>
        </div>
        <div class="split-visual reveal reveal-delay-2">
          <div class="benefits-grid">
            <div class="benefit-item">
              <span class="benefit-num">01</span>
              <p>Increased local visibility so nearby pet owners discover you first.</p>
            </div>
            <div class="benefit-item">
              <span class="benefit-num">02</span>
              <p>More appointment bookings and new patient calls driven by search rankings.</p>
            </div>
            <div class="benefit-item">
              <span class="benefit-num">03</span>
              <p>A stronger, actively managed online reputation that builds trust.</p>
            </div>
            <div class="benefit-item">
              <span class="benefit-num">04</span>
              <p>A clear competitive advantage over local clinics and corporate groups.</p>
            </div>
            <div class="benefit-item">
              <span class="benefit-num">05</span>
              <p>Showcase specialized services to exactly the clients seeking them.</p>
            </div>
            <div class="benefit-item">
              <span class="benefit-num">06</span>
              <p>Sustainable, long-term patient acquisition without relying on paid ads.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- OUR PROCESS -->
  <section class="section section--chalk">
    <div class="container">
      <SectionHeading
        eyebrow="Our Process"
        title="Our Proven Veterinary SEO Process"
        subtitle="We take the mystery out of SEO with a clear, repeatable methodology built for consistent results."
      />
      <ProcessTimeline steps={processSteps} />
    </div>
  </section>

  <!-- CASE STUDY -->
  <section class="section section--white">
    <div class="container">
      <SectionHeading
        eyebrow="Real Results"
        title="Real Results for Real Veterinary Practices"
        subtitle="Our clients trusted us with their growth — and gave us permission to share it."
      />

      <div class="case-study reveal">
        <div class="case-study-inner">
          <div class="case-study-content">
            <h3>Case Study: Boosting New Patient Inquiries by 56%</h3>
            
            <div class="case-blocks">
              <div class="case-block">
                <h4 class="case-block-label">The Challenge</h4>
                <p>Sajjad Pets Clinic was offering exceptional care but struggling with low online visibility and unpredictable new patient flow.</p>
              </div>
              <div class="case-block">
                <h4 class="case-block-label">Our Solution</h4>
                <p>We implemented targeted local SEO — optimizing their Google Business Profile, building hyper-local keyword campaigns, and launching blog content addressing common pet health questions.</p>
              </div>
              <div class="case-block">
                <h4 class="case-block-label">The Results</h4>
                <p><strong>56% increase</strong> in new patient calls within a month. Climbed to <strong>4th position</strong> from complete invisibility in local search.</p>
              </div>
            </div>
          </div>
          <div class="case-study-visual">
            <img src="/images/Sajjad-pets-clinic-local-ranking-map.jpg" alt="Sajjad Pets Clinic local ranking improvement map showing climb to 4th position" loading="lazy" />
            <div class="case-stat">
              <span class="case-stat-value">56%</span>
              <span class="case-stat-label">More Patient Calls</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ROI CALCULATOR -->
  <ROICalculator />

  <!-- WHY CHOOSE PAW RANK -->
  <section class="section section--chalk">
    <div class="container">
      <SectionHeading
        eyebrow="Why Paw Rank"
        title="Why Choose Paw Rank as Your Veterinary SEO Company"
      />

      <div class="grid grid--3">
        {whyCards.map((card, i) => (
          <FeatureCard
            icon={card.icon}
            title={card.title}
            description={card.description}
            delay={(i % 3) + 1}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- STATS BAR -->
  <section class="section section--white" style="padding-top: 0; padding-bottom: 0;">
    <StatsBar stats={[
      { value: "16+", label: "Businesses Helped" },
      { value: "100%", label: "Veterinary Focus" },
      { value: "3", label: "Core Areas: SEO • Local • CRO" },
    ]} />
  </section>

  <!-- FAQ -->
  <section class="section section--white">
    <div class="container">
      <SectionHeading
        eyebrow="FAQ"
        title="Frequently Asked Questions"
      />
      <FAQ items={faqItems} />
    </div>
  </section>

  <!-- CTA BANNER -->
  <CTABanner
    title="Ready to Fill Your Appointment Book?"
    subtitle="Don't let your exceptional patient care go unnoticed. The pet owners who need you are searching online right now — let's make sure they find you."
    primaryCta={{ label: "Book a Free 30-Min Consultation", href: "/contact/#calendly" }}
    secondaryCta={{ label: "Contact Us", href: "/contact/" }}
  />
</BaseLayout>

<style>
  /* Split Section */
  .split-section {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: start;
  }

  .split-content h2 {
    margin-top: 12px;
    margin-bottom: 20px;
  }

  .split-content p {
    margin-bottom: 16px;
  }

  .benefits-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .benefit-item {
    background: var(--pr-chalk);
    border-radius: var(--radius-lg);
    padding: 20px;
    border: 1px solid var(--pr-border);
    transition: all var(--transition-base);
  }

  .benefit-item:hover {
    border-color: rgba(50, 92, 232, 0.15);
    transform: translateY(-2px);
    box-shadow: var(--shadow-subtle);
  }

  .benefit-num {
    font-family: var(--font-heading);
    font-size: 24px;
    font-weight: 900;
    color: var(--pr-blue);
    display: block;
    margin-bottom: 8px;
  }

  .benefit-item p {
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--pr-text);
    margin: 0;
  }

  /* Case Study */
  .case-study {
    max-width: 1080px;
    margin: 0 auto;
  }

  .case-study-inner {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 48px;
    background: var(--pr-white);
    border: 1px solid var(--pr-border);
    border-radius: var(--radius-2xl);
    padding: 48px;
    box-shadow: var(--shadow-card);
  }

  .case-study-content h3 {
    font-size: 24px;
    margin-bottom: 28px;
    color: var(--pr-navy);
  }

  .case-blocks {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .case-block {
    padding: 16px 20px;
    border-left: 3px solid var(--pr-blue);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    background: var(--pr-light-blue);
  }

  .case-block-label {
    font-family: var(--font-heading);
    font-size: 13px;
    font-weight: 800;
    color: var(--pr-blue);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 6px;
  }

  .case-block p {
    font-size: 14.5px;
    margin: 0;
  }

  .case-study-visual {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .case-study-visual img {
    border-radius: var(--radius-lg);
    width: 100%;
    object-fit: cover;
  }

  .case-stat {
    background: var(--pr-navy);
    border-radius: var(--radius-lg);
    padding: 24px;
    text-align: center;
  }

  .case-stat-value {
    display: block;
    font-family: var(--font-heading);
    font-size: 48px;
    font-weight: 900;
    color: var(--pr-success);
    line-height: 1;
  }

  .case-stat-label {
    display: block;
    margin-top: 6px;
    font-size: 14px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.7);
  }

  @media (max-width: 900px) {
    .split-section {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .case-study-inner {
      grid-template-columns: 1fr;
      padding: 28px;
    }
  }

  @media (max-width: 600px) {
    .benefits-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
