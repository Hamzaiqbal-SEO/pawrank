---
const endpoint = import.meta.env.PUBLIC_CONTACT_FORM_ENDPOINT || 'https://script.google.com/macros/s/AKfycbxyMohSFgG-s15BKoqpGEFTvR4rpupYc44zURRt5kGLOHh5uxw1t2FXw9hQIUUlBc7WlQ/exec';
---

<div class="contact-form-container">
  <!-- CONTACT FORM -->
  <form 
    class="contact-form" 
    id="pawrank-contact-form" 
    action={endpoint} 
    method="POST"
    data-endpoint={endpoint}
  >
    <!-- Silent bot honeypot (hidden from real users) -->
    <div class="form-honeypot" aria-hidden="true">
      <label for="form-botcheck">Do not fill this field</label>
      <input type="text" id="form-botcheck" name="_gotcha" tabindex="-1" autocomplete="off" />
    </div>

    <div class="form-grid">
      <div class="form-group">
        <label for="name" class="form-label">Your Name *</label>
        <input type="text" id="name" name="name" required class="form-input" placeholder="Dr. Jane Smith" />
      </div>
      
      <div class="form-group">
        <label for="email" class="form-label">Email Address *</label>
        <input type="email" id="email" name="email" required class="form-input" placeholder="jane@vetclinic.com" />
      </div>
      
      <div class="form-group">
        <label for="clinic" class="form-label">Clinic Name & Location</label>
        <input type="text" id="clinic" name="clinic" class="form-input" placeholder="Happy Paws Vet, Austin TX" />
      </div>
      
      <div class="form-group">
        <label for="website" class="form-label">Website (if any)</label>
        <input type="url" id="website" name="website" class="form-input" placeholder="https://yourvetclinic.com" />
      </div>
    </div>
    
    <div class="form-group form-group--full">
      <label for="message" class="form-label">Tell us about your practice *</label>
      <textarea id="message" name="message" required class="form-input form-textarea" rows="5" placeholder="What are your biggest challenges with online visibility? What services do you want to grow?"></textarea>
    </div>
    
    <button type="submit" class="btn btn--primary btn--full" id="form-submit">
      Send Message
    </button>
    
    <div class="form-status" id="form-status"></div>
  </form>

  <!-- INLINE BRANDED SUCCESS STATE (Replaces form after submission) -->
  <div class="success-card" id="form-success-state" style="display: none;" aria-live="polite">
    <!-- Top accent bar -->
    <div class="success-card__accent"></div>

    <div class="success-card__badge-wrapper">
      <div class="success-card__icon-container">
        <svg class="success-card__icon" width="38" height="38" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12" class="checkmark-path"></polyline>
        </svg>
      </div>
      <span class="eyebrow eyebrow--blue">Response Submitted</span>
    </div>

    <h3 class="success-card__title">Thank You for Reaching Out!</h3>
    <p class="success-card__text">
      We've successfully received your clinic's details. Our team is already analyzing your local veterinary competitive landscape and will be in touch within <strong>24–48 hours</strong>.
    </p>

    <!-- Metadata highlights -->
    <div class="success-card__meta">
      <div class="meta-item">
        <div class="meta-item__icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
        </div>
        <div class="meta-item__content">
          <span class="meta-item__label">Response Time</span>
          <strong class="meta-item__value">Within 24 business hours</strong>
        </div>
      </div>

      <div class="meta-item">
        <div class="meta-item__icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
            <polyline points="22,6 12,13 2,6"></polyline>
          </svg>
        </div>
        <div class="meta-item__content">
          <span class="meta-item__label">Confirmation Email</span>
          <strong class="meta-item__value">Sent to your inbox</strong>
        </div>
      </div>
    </div>

    <!-- Interactive Actions -->
    <div class="success-card__actions">
      <button type="button" class="btn btn--outline success-reset-btn" id="btn-submit-new">
        <svg class="reset-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path>
        </svg>
        <span>Submit a New Form</span>
      </button>

      <a href="#calendly" class="btn btn--primary success-calendly-btn">
        <span>Book Strategy Call</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>

    <div class="success-card__footnote">
      Need urgent help? Reach us directly at <a href="mailto:pawrankofficial@gmail.com" class="footnote-link">pawrankofficial@gmail.com</a>
    </div>
  </div>
</div>

<!-- Confirmation Modal Popup (Paw Rank Brand Aligned) -->
<div class="modal-overlay" id="submission-modal" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="modal-title">
  <div class="modal-card">
    <button type="button" class="modal-close-icon" id="modal-close-x" aria-label="Close dialog">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="1" y1="1" x2="13" y2="13"></line>
        <line x1="13" y1="1" x2="1" y2="13"></line>
      </svg>
    </button>

    <div class="modal-body">
      <!-- Brand Icon / Badge -->
      <div class="modal-badge-wrapper">
        <div class="modal-brand-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </div>
        <span class="eyebrow eyebrow--blue">Inquiry Received</span>
      </div>

      <h3 class="modal-title" id="modal-title">Speak soon!</h3>

      <p class="modal-text">
        We've received your request and will call you back within <strong>48 hours</strong>.
      </p>

      <p class="modal-subtext">
        If you're unable to pick up or you've changed your mind, please email us anytime at <a href="mailto:pawrankofficial@gmail.com" class="modal-email-link">pawrankofficial@gmail.com</a>.
      </p>

      <!-- Primary Action -->
      <button type="button" class="btn btn--primary btn--full modal-submit-btn" id="modal-close-btn">
        CLOSE
      </button>

      <!-- Calendly Alternative -->
      <div class="modal-footer-note">
        <span>Need to talk sooner?</span>
        <a href="#calendly" class="modal-calendly-link" id="modal-calendly-link">Book on our calendar &rarr;</a>
      </div>
    </div>
  </div>
</div>

<style>
  .contact-form-container {
    max-width: 700px;
    margin: 0 auto;
    position: relative;
  }

  .contact-form {
    width: 100%;
    animation: fadeIn 0.35s ease;
  }

  .form-honeypot {
    display: none !important;
    position: absolute !important;
    left: -9999px !important;
    visibility: hidden !important;
  }

  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 20px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .form-group--full {
    margin-bottom: 24px;
  }

  .form-label {
    font-family: var(--font-heading);
    font-size: 13px;
    font-weight: 700;
    color: var(--pr-navy);
    letter-spacing: 0.02em;
  }

  .form-input {
    width: 100%;
    padding: 14px 18px;
    border: 1px solid var(--pr-border-dark);
    border-radius: var(--radius-md);
    background: var(--pr-white);
    font-size: 15px;
    font-family: var(--font-body);
    color: var(--pr-black);
    transition: all 0.2s ease;
    outline: none;
  }

  .form-input::placeholder {
    color: rgba(74, 96, 128, 0.5);
  }

  .form-input:focus {
    border-color: var(--pr-blue);
    box-shadow: 0 0 0 3px rgba(50, 92, 232, 0.1);
  }

  .form-textarea {
    resize: vertical;
    min-height: 120px;
  }

  .form-status {
    text-align: center;
    margin-top: 16px;
    font-size: 14px;
    font-weight: 600;
    min-height: 20px;
  }

  .form-status.success {
    color: var(--pr-success);
  }

  .form-status.error {
    color: var(--pr-coral);
  }

  /* ── INLINE SUCCESS STATE CARD ── */
  .success-card {
    position: relative;
    background: var(--pr-white);
    border: 1px solid var(--pr-border-dark);
    border-radius: var(--radius-2xl);
    padding: 48px 40px 36px 40px;
    box-shadow: var(--shadow-card);
    text-align: center;
    overflow: hidden;
    animation: fadeInUp 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .success-card__accent {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: var(--gradient-hero);
  }

  .success-card__badge-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
  }

  .success-card__icon-container {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: var(--pr-light-blue);
    color: var(--pr-blue);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 10px 24px rgba(50, 92, 232, 0.18);
    transition: transform 0.3s ease;
  }

  .success-card:hover .success-card__icon-container {
    transform: scale(1.06);
  }

  .checkmark-path {
    stroke-dasharray: 40;
    stroke-dashoffset: 0;
    animation: strokeDraw 0.6s ease-in-out forwards;
  }

  @keyframes strokeDraw {
    from {
      stroke-dashoffset: 40;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  .success-card__title {
    font-family: var(--font-heading);
    font-size: clamp(24px, 3vw, 30px);
    font-weight: 800;
    color: var(--pr-navy);
    margin: 0 0 14px 0;
    letter-spacing: -0.025em;
    line-height: 1.2;
  }

  .success-card__text {
    font-family: var(--font-body);
    font-size: 15.5px;
    line-height: 1.65;
    color: var(--pr-text);
    max-width: 520px;
    margin: 0 auto 30px auto;
  }

  .success-card__text strong {
    color: var(--pr-navy);
  }

  .success-card__meta {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    background: var(--pr-chalk);
    border: 1px solid var(--pr-border);
    border-radius: var(--radius-lg);
    padding: 18px 22px;
    margin: 0 auto 32px auto;
    text-align: left;
  }

  .meta-item {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .meta-item__icon {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--pr-white);
    color: var(--pr-blue);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    border: 1px solid var(--pr-border);
  }

  .meta-item__content {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .meta-item__label {
    font-size: 12px;
    color: var(--pr-text);
    font-weight: 500;
  }

  .meta-item__value {
    font-size: 13.5px;
    color: var(--pr-navy);
    font-weight: 700;
  }

  .success-card__actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 24px;
  }

  .success-reset-btn {
    padding: 14px 26px;
    font-size: 13px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
  }

  .success-reset-btn .reset-icon {
    transition: transform 0.4s ease;
  }

  .success-reset-btn:hover .reset-icon {
    transform: rotate(-180deg);
  }

  .success-calendly-btn {
    padding: 14px 28px;
    font-size: 13px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .success-calendly-btn svg {
    transition: transform 0.2s ease;
  }

  .success-calendly-btn:hover svg {
    transform: translateX(3px);
  }

  .success-card__footnote {
    font-size: 13px;
    color: var(--pr-text);
    line-height: 1.5;
  }

  .footnote-link {
    color: var(--pr-blue);
    font-weight: 600;
    text-decoration: none;
  }

  .footnote-link:hover {
    color: var(--pr-blue-hover);
    text-decoration: underline;
  }

  /* ── Confirmation Modal Popup ── */
  .modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(11, 40, 69, 0.65);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    z-index: 99999;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.25s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .modal-overlay.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .modal-card {
    position: relative;
    width: 100%;
    max-width: 440px;
    background: var(--pr-white);
    border: 1px solid var(--pr-border-dark);
    border-radius: var(--radius-2xl);
    padding: 38px 34px 32px 34px;
    box-shadow: var(--shadow-navy);
    transform: scale(0.92) translateY(12px);
    transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1);
    overflow: hidden;
  }

  .modal-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: var(--gradient-hero);
  }

  .modal-overlay.is-open .modal-card {
    transform: scale(1) translateY(0);
  }

  .modal-close-icon {
    position: absolute;
    top: 18px;
    right: 18px;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--pr-chalk);
    border: 1px solid var(--pr-border);
    border-radius: 50%;
    color: var(--pr-navy);
    cursor: pointer;
    transition: all 0.2s ease;
    padding: 0;
  }

  .modal-close-icon:hover {
    color: var(--pr-blue);
    background: var(--pr-light-blue);
    border-color: var(--pr-blue-light);
    transform: rotate(90deg);
  }

  .modal-body {
    text-align: left;
  }

  .modal-badge-wrapper {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
  }

  .modal-brand-icon {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--pr-light-blue);
    color: var(--pr-blue);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: 0 4px 12px rgba(50, 92, 232, 0.15);
  }

  .modal-title {
    font-family: var(--font-heading);
    font-size: 28px;
    font-weight: 800;
    color: var(--pr-navy);
    margin: 0 0 14px 0;
    letter-spacing: -0.025em;
    line-height: 1.15;
  }

  .modal-text {
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.6;
    color: var(--pr-text);
    margin: 0 0 14px 0;
  }

  .modal-text strong {
    color: var(--pr-navy);
  }

  .modal-subtext {
    font-family: var(--font-body);
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--pr-text);
    margin: 0 0 28px 0;
    padding: 12px 14px;
    background: var(--pr-chalk);
    border-radius: var(--radius-md);
    border-left: 3px solid var(--pr-blue);
  }

  .modal-email-link {
    color: var(--pr-blue);
    font-weight: 600;
    text-decoration: none;
    word-break: break-all;
    transition: color 0.15s ease;
  }

  .modal-email-link:hover {
    color: var(--pr-blue-hover);
    text-decoration: underline;
  }

  .modal-submit-btn {
    letter-spacing: 0.08em;
    font-size: 13px;
    padding: 16px 28px;
  }

  .modal-footer-note {
    margin-top: 18px;
    text-align: center;
    font-size: 13px;
    color: var(--pr-text);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    flex-wrap: wrap;
  }

  .modal-calendly-link {
    color: var(--pr-blue);
    font-weight: 700;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .modal-calendly-link:hover {
    color: var(--pr-blue-hover);
    text-decoration: underline;
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 600px) {
    .form-grid {
      grid-template-columns: 1fr;
    }
    .success-card {
      padding: 36px 20px 28px 20px;
    }
    .success-card__meta {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .success-card__actions {
      flex-direction: column;
      width: 100%;
    }
    .success-card__actions .btn {
      width: 100%;
    }
  }
</style>

<script>
  const form = document.getElementById('pawrank-contact-form') as HTMLFormElement;
  const status = document.getElementById('form-status');
  const submitBtn = document.getElementById('form-submit');
  const successState = document.getElementById('form-success-state');
  const submitNewBtn = document.getElementById('btn-submit-new');

  // Modal elements
  const modal = document.getElementById('submission-modal');
  const closeBtn = document.getElementById('modal-close-btn');
  const closeX = document.getElementById('modal-close-x');
  const calendlyLink = document.getElementById('modal-calendly-link');

  function openModal() {
    if (!modal) return;
    modal.classList.add('is-open');
    modal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    closeBtn?.focus();
  }

  function closeModal() {
    if (!modal) return;
    modal.classList.remove('is-open');
    modal.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    submitNewBtn?.focus();
  }

  closeBtn?.addEventListener('click', closeModal);
  closeX?.addEventListener('click', closeModal);
  calendlyLink?.addEventListener('click', closeModal);

  // Close when clicking backdrop outside card
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) {
      closeModal();
    }
  });

  // Close on Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal?.classList.contains('is-open')) {
      closeModal();
    }
  });

  // Reset and show form again
  submitNewBtn?.addEventListener('click', () => {
    if (!form || !successState) return;

    form.reset();
    if (status) {
      status.textContent = '';
      status.className = 'form-status';
    }

    successState.style.display = 'none';
    form.style.display = 'block';

    // Scroll smoothly to top of form and focus first field
    form.scrollIntoView({ behavior: 'smooth', block: 'center' });
    const firstInput = form.querySelector('input[name="name"]') as HTMLInputElement;
    firstInput?.focus();
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!submitBtn || !status) return;

    const actionUrl = form.dataset.endpoint || form.action;
    if (!actionUrl || actionUrl.includes('YOUR_DEPLOYMENT_ID') || actionUrl.includes('YOUR_SCRIPT_ID')) {
      status.textContent = 'Backend endpoint not configured yet. Please configure your Google Apps Script URL.';
      status.className = 'form-status error';
      return;
    }

    submitBtn.textContent = 'Sending...';
    submitBtn.setAttribute('disabled', 'true');
    status.textContent = '';
    status.className = 'form-status';

    try {
      const formData = new FormData(form);
      let isSuccess = false;

      try {
        const response = await fetch(actionUrl, {
          method: 'POST',
          body: formData,
        });

        if (response.ok || response.type === 'opaque') {
          const data = await response.json().catch(() => null);
          if (!data || data.status !== 'error') {
            isSuccess = true;
          }
        }
      } catch (corsErr) {
        // Safe fallback: Google Apps Script redirect can trigger CORS in certain browsers
        // mode: 'no-cors' guarantees submission reaches the backend
        await fetch(actionUrl, {
          method: 'POST',
          body: formData,
          mode: 'no-cors',
        });
        isSuccess = true;
      }

      if (isSuccess) {
        // 1. Hide the form immediately
        form.style.display = 'none';

        // 2. Show the interactive branded success card
        if (successState) {
          successState.style.display = 'block';
        }

        // 3. Open the confirmation modal popup
        openModal();
      } else {
        throw new Error('Submission error');
      }
    } catch (err) {
      console.error('Contact form submission error:', err);
      status.textContent = 'Something went wrong. Please email us at pawrankofficial@gmail.com';
      status.className = 'form-status error';
    } finally {
      submitBtn.textContent = 'Send Message';
      submitBtn.removeAttribute('disabled');
    }
  });
</script>
