---
---

<form class="contact-form" id="contact-form" action="https://formspree.io/f/xwpkqjqr" method="POST">
  <div class="form-grid">
    <div class="form-group">
      <label for="name" class="form-label">Your Name *</label>
      <input type="text" id="name" name="name" required class="form-input" placeholder="Dr. Jane Smith" />
    </div>
    
    <div class="form-group">
      <label for="email" class="form-label">Email Address *</label>
      <input type="email" id="email" name="email" required class="form-input" placeholder="jane@vetclinic.com" />
    </div>
    
    <div class="form-group">
      <label for="clinic" class="form-label">Clinic Name & Location</label>
      <input type="text" id="clinic" name="clinic" class="form-input" placeholder="Happy Paws Vet, Austin TX" />
    </div>
    
    <div class="form-group">
      <label for="website" class="form-label">Website (if any)</label>
      <input type="url" id="website" name="website" class="form-input" placeholder="https://yourvetclinic.com" />
    </div>
  </div>
  
  <div class="form-group form-group--full">
    <label for="message" class="form-label">Tell us about your practice *</label>
    <textarea id="message" name="message" required class="form-input form-textarea" rows="5" placeholder="What are your biggest challenges with online visibility? What services do you want to grow?"></textarea>
  </div>
  
  <button type="submit" class="btn btn--primary btn--full" id="form-submit">
    Send Message
  </button>
  
  <div class="form-status" id="form-status"></div>
</form>

<style>
  .contact-form {
    max-width: 700px;
    margin: 0 auto;
  }

  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 20px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .form-group--full {
    margin-bottom: 24px;
  }

  .form-label {
    font-family: var(--font-heading);
    font-size: 13px;
    font-weight: 700;
    color: var(--pr-navy);
    letter-spacing: 0.02em;
  }

  .form-input {
    width: 100%;
    padding: 14px 18px;
    border: 1px solid var(--pr-border-dark);
    border-radius: var(--radius-md);
    background: var(--pr-white);
    font-size: 15px;
    font-family: var(--font-body);
    color: var(--pr-black);
    transition: all 0.2s ease;
    outline: none;
  }

  .form-input::placeholder {
    color: rgba(74, 96, 128, 0.5);
  }

  .form-input:focus {
    border-color: var(--pr-blue);
    box-shadow: 0 0 0 3px rgba(50, 92, 232, 0.1);
  }

  .form-textarea {
    resize: vertical;
    min-height: 120px;
  }

  .form-status {
    text-align: center;
    margin-top: 16px;
    font-size: 14px;
    font-weight: 600;
    min-height: 20px;
  }

  .form-status.success {
    color: var(--pr-success);
  }

  .form-status.error {
    color: var(--pr-coral);
  }

  @media (max-width: 600px) {
    .form-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const status = document.getElementById('form-status');
  const submitBtn = document.getElementById('form-submit');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!submitBtn || !status) return;

    submitBtn.textContent = 'Sending...';
    submitBtn.setAttribute('disabled', 'true');

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });

      if (response.ok) {
        status.textContent = '✓ Message sent! We\'ll get back to you soon.';
        status.className = 'form-status success';
        form.reset();
      } else {
        throw new Error('Failed');
      }
    } catch {
      status.textContent = 'Something went wrong. Please email us at pawrankofficial@gmail.com';
      status.className = 'form-status error';
    } finally {
      submitBtn.textContent = 'Send Message';
      submitBtn.removeAttribute('disabled');
    }
  });
</script>
