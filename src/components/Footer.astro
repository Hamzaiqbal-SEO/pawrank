---
const currentYear = new Date().getFullYear();

const footerLinks = {
  company: [
    { label: 'About', href: '/about/' },
    { label: 'Pricing', href: '/pricing/' },
    { label: 'Blog', href: '/blog/' },
    { label: 'Contact', href: '/contact/' },
    { label: 'Privacy Policy', href: '/privacy-policy/' },
  ],
  services: [
    { label: 'Local SEO', href: '/pricing/' },
    { label: 'Google Business Profile', href: '/pricing/' },
    { label: 'Content Strategy', href: '/pricing/' },
    { label: 'Technical SEO', href: '/pricing/' },
    { label: 'Reputation Management', href: '/pricing/' },
    { label: 'CRO', href: '/pricing/' },
  ],
};
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-grid">
      <!-- Brand Column -->
      <div class="footer-brand">
        <a href="/" class="footer-logo">
          <img src="/images/pawrank-logo.png" alt="Paw Rank" width="130" height="38" />
        </a>
        <p class="footer-tagline">
          Helping veterinary clinics grow through local SEO, 
          reputation management, and transparent reporting.
        </p>
        <a href="mailto:pawrankofficial@gmail.com" class="footer-email">
          pawrankofficial@gmail.com
        </a>
      </div>

      <!-- Company Links -->
      <div class="footer-col">
        <h4 class="footer-col-title">Company</h4>
        <ul class="footer-list">
          {footerLinks.company.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Services Links -->
      <div class="footer-col">
        <h4 class="footer-col-title">Services</h4>
        <ul class="footer-list">
          {footerLinks.services.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- CTA Column -->
      <div class="footer-col footer-cta-col">
        <h4 class="footer-col-title">Ready to Grow?</h4>
        <p class="footer-cta-text">
          Let's build a clear SEO plan for your veterinary practice.
        </p>
        <a href="/contact/#calendly" class="btn btn--primary btn--sm">
          Book a Free Call
        </a>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; {currentYear} Paw Rank. All rights reserved.</p>
      <p class="footer-built">
        <span>Built with</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="#325CE8" style="display: inline-block; vertical-align: middle; margin: 0 4px;" xmlns="http://www.w3.org/2000/svg">
          <path d="M12 13.5C10.6193 13.5 9.5 14.6193 9.5 16C9.5 17.3807 10.6193 18.5 12 18.5C13.3807 18.5 14.5 17.3807 14.5 16C14.5 14.6193 13.3807 13.5 12 13.5Z"/>
          <path d="M8.5 17.5C7.39543 17.5 6.5 18.3954 6.5 19.5C6.5 20.6046 7.39543 21.5 8.5 21.5C9.60457 21.5 10.5 20.6046 10.5 19.5C10.5 18.3954 9.60457 17.5 8.5 17.5Z"/>
          <path d="M15.5 17.5C14.3954 17.5 13.5 18.3954 13.5 19.5C13.5 20.6046 14.3954 21.5 15.5 21.5C16.6046 21.5 17.5 20.6046 17.5 19.5C17.5 18.3954 16.6046 17.5 15.5 17.5Z"/>
          <path d="M6 13C5.17157 13 4.5 13.6716 4.5 14.5C4.5 15.3284 5.17157 16 6 16C6.82843 16 7.5 15.3284 7.5 14.5C7.5 13.6716 6.82843 13 6 13Z"/>
          <path d="M18 13C17.1716 13 16.5 13.6716 16.5 14.5C16.5 15.3284 17.1716 16 18 16C18.8284 16 19.5 15.3284 19.5 14.5C19.5 13.6716 18.8284 13 18 13Z"/>
          <path d="M12 9C10.3431 9 9 10.3431 9 12C9 13.6569 10.3431 15 12 15C13.6569 15 15 13.6569 15 12C15 10.3431 13.6569 9 12 9Z"/>
        </svg>
        <span>for veterinary clinics worldwide</span>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--pr-navy);
    color: rgba(255, 255, 255, 0.75);
    padding: 80px 24px 32px;
  }

  .footer-inner {
    max-width: 1280px;
    margin: 0 auto;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1.2fr;
    gap: 48px;
    padding-bottom: 48px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .footer-logo img {
    height: 32px;
    width: auto;
    filter: brightness(0) invert(1);
  }

  .footer-tagline {
    font-size: 14px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.6);
    max-width: 280px;
  }

  .footer-email {
    font-size: 14px;
    font-weight: 600;
    color: var(--pr-blue-light);
    transition: color 0.2s ease;
  }

  .footer-email:hover {
    color: var(--pr-white);
  }

  .footer-col-title {
    font-family: var(--font-heading);
    font-size: 13px;
    font-weight: 800;
    color: var(--pr-white);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 20px;
  }

  .footer-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-list a {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.6);
    transition: color 0.2s ease;
  }

  .footer-list a:hover {
    color: var(--pr-white);
  }

  .footer-cta-text {
    font-size: 14px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.6);
    margin-bottom: 20px;
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 24px;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.4);
  }

  .footer-built {
    font-size: 13px;
  }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 40px;
    }
  }

  @media (max-width: 600px) {
    .site-footer {
      padding: 60px 16px 24px;
    }

    .footer-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .footer-bottom {
      flex-direction: column;
      gap: 8px;
      text-align: center;
    }
  }
</style>
