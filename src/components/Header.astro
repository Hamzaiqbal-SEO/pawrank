---
const services = [
  {
    title: "Local Veterinary SEO",
    description: "Rank #1 when pet owners search for local care.",
    href: "/pricing/",
    icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>`
  },
  {
    title: "Google Business Profile",
    description: "Dominate Google Maps and the 3-Pack.",
    href: "/pricing/",
    icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>`
  },
  {
    title: "Reputation Management",
    description: "Build trust with automated client reviews.",
    href: "/pricing/",
    icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>`
  },
  {
    title: "Conversion Optimization (CRO)",
    description: "Convert website traffic into booked appointments.",
    href: "/pricing/",
    icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>`
  },
];

const resources = [
  {
    title: "Veterinary SEO Guide",
    description: "Our complete 30-day pillar guide to gaining more clients.",
    href: "/blog/veterinary-seo-guide/",
    badge: "Guide"
  },
  {
    title: "ROI Calculator",
    description: "Calculate revenue potential from position 1 rankings.",
    href: "/#vet-seo-roi-calculator",
    badge: "Tool"
  },
  {
    title: "All Articles & Insights",
    description: "Industry news, algorithm updates, and growth tips.",
    href: "/blog/",
  },
];
---

<!-- Navigation 2: Centered Floating Rounded Glass Nav with Expanding Card Dropdowns -->
<div class="nav-floating-wrapper" id="nav-wrapper">
  <header class="nav-pill-header" id="nav-header">
    <div class="nav-pill-inner">
      
      <!-- Logo -->
      <a href="/" class="nav-logo" aria-label="Paw Rank Home">
        <img src="/images/Pawrank-Logo.png" alt="Paw Rank" width="132" height="36" />
      </a>

      <!-- Desktop Nav Items -->
      <nav class="nav-links" aria-label="Main Navigation">
        
        <!-- Services Dropdown Trigger & Expanding Card Panel -->
        <div class="nav-item has-dropdown" data-dropdown="services">
          <button class="nav-link-btn" aria-expanded="false">
            <span>Services</span>
            <svg class="chevron-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>

          <!-- Expanding Card Dropdown -->
          <div class="dropdown-panel dropdown-panel--services">
            <div class="dropdown-card-grid">
              <div class="dropdown-items">
                {services.map((svc) => (
                  <a href={svc.href} class="dropdown-item-card">
                    <div class="dropdown-item-icon" set:html={svc.icon} />
                    <div class="dropdown-item-text">
                      <span class="dropdown-item-title">{svc.title}</span>
                      <span class="dropdown-item-desc">{svc.description}</span>
                    </div>
                  </a>
                ))}
              </div>
              
              <!-- Featured Card in Dropdown -->
              <div class="dropdown-featured-card">
                <div class="featured-badge">Case Study</div>
                <h4 class="featured-title">+56% Patient Inquiries</h4>
                <p class="featured-desc">See how Sajjad Pets Clinic climbed to top 4 in local search in 30 days.</p>
                <a href="/pricing/" class="featured-link">Explore Plans & ROI →</a>
              </div>
            </div>
          </div>
        </div>

        <!-- Regular Links -->
        <a href="/pricing/" class="nav-link">Pricing</a>
        <a href="/about/" class="nav-link">About</a>

        <!-- Resources Dropdown Trigger & Expanding Card Panel -->
        <div class="nav-item has-dropdown" data-dropdown="resources">
          <button class="nav-link-btn" aria-expanded="false">
            <span>Resources</span>
            <svg class="chevron-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>

          <div class="dropdown-panel dropdown-panel--resources">
            <div class="dropdown-resources-list">
              {resources.map((res) => (
                <a href={res.href} class="resource-item-card">
                  <div class="resource-header">
                    <span class="resource-title">{res.title}</span>
                    {res.badge && <span class="resource-badge">{res.badge}</span>}
                  </div>
                  <span class="resource-desc">{res.description}</span>
                </a>
              ))}
            </div>
          </div>
        </div>

        <a href="/contact/" class="nav-link">Contact</a>
      </nav>

      <!-- Action Button -->
      <div class="nav-actions">
        <a href="/contact/#calendly" class="btn btn--primary btn--sm nav-cta-btn">
          Book a Free Call
        </a>

        <!-- Mobile Toggle Button -->
        <button class="mobile-toggle-btn" id="mobile-toggle-btn" aria-label="Toggle mobile menu" aria-expanded="false">
          <span class="hamburger-bar"></span>
        </button>
      </div>

    </div>

    <!-- Mobile Dropdown Drawer -->
    <div class="mobile-drawer" id="mobile-drawer">
      <nav class="mobile-drawer-nav">
        
        <a href="/" class="mobile-nav-link">
          <span>Home</span>
        </a>
        
        <!-- Mobile Services Accordion Section -->
        <div class="mobile-accordion-group">
          <button class="mobile-accordion-btn" id="mobile-services-btn" aria-expanded="false">
            <span class="mobile-accordion-label">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--pr-blue)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2z"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
              <span>Services</span>
            </span>
            <svg class="mobile-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>

          <div class="mobile-accordion-body" id="mobile-services-body">
            <div class="mobile-services-list">
              {services.map((svc) => (
                <a href={svc.href} class="mobile-service-card">
                  <div class="mobile-svc-icon" set:html={svc.icon} />
                  <div class="mobile-svc-info">
                    <span class="mobile-svc-title">{svc.title}</span>
                    <span class="mobile-svc-desc">{svc.description}</span>
                  </div>
                  <span class="mobile-svc-arrow">›</span>
                </a>
              ))}
            </div>
          </div>
        </div>

        <a href="/pricing/" class="mobile-nav-link">
          <span>Pricing</span>
          <span class="mobile-link-badge">From $750</span>
        </a>
        
        <a href="/about/" class="mobile-nav-link">
          <span>About Us</span>
        </a>

        <!-- Mobile Resources Section -->
        <div class="mobile-accordion-group">
          <button class="mobile-accordion-btn" id="mobile-resources-btn" aria-expanded="false">
            <span class="mobile-accordion-label">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--pr-blue)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
              <span>Resources</span>
            </span>
            <svg class="mobile-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>

          <div class="mobile-accordion-body" id="mobile-resources-body">
            <div class="mobile-resources-list">
              {resources.map((res) => (
                <a href={res.href} class="mobile-resource-card">
                  <span class="mobile-res-title">{res.title}</span>
                  {res.badge && <span class="mobile-res-badge">{res.badge}</span>}
                </a>
              ))}
            </div>
          </div>
        </div>

        <a href="/contact/" class="mobile-nav-link">
          <span>Contact</span>
        </a>
        
        <!-- Mobile Drawer CTA Banner -->
        <div class="mobile-drawer-footer">
          <a href="/contact/#calendly" class="btn btn--primary btn--full mobile-primary-cta">
            Book a Free Consultation
          </a>
          <p class="mobile-footer-tag">100% Focused on Veterinary Growth</p>
        </div>
      </nav>
    </div>

  </header>
</div>

<style>
  /* Floating Pill Wrapper (Navigation 2) */
  .nav-floating-wrapper {
    position: fixed;
    top: 16px;
    left: 0;
    right: 0;
    z-index: 1000;
    padding: 0 20px;
    display: flex;
    justify-content: center;
    pointer-events: none;
  }

  .nav-pill-header {
    pointer-events: all;
    max-width: 1040px;
    width: 100%;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border: 1px solid rgba(11, 40, 69, 0.1);
    border-radius: var(--radius-pill);
    box-shadow: 0 10px 30px rgba(11, 40, 69, 0.08), 0 1px 3px rgba(11, 40, 69, 0.04);
    transition: max-width 0.45s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.45s cubic-bezier(0.22, 1, 0.36, 1), border-color 0.3s ease, background-color 0.3s ease;
    position: relative;
  }

  .nav-pill-header.scrolled {
    background: rgba(255, 255, 255, 0.98);
    box-shadow: 0 14px 36px rgba(11, 40, 69, 0.12), 0 2px 6px rgba(11, 40, 69, 0.06);
    border-color: rgba(50, 92, 232, 0.2);
  }

  /* Desktop Hover Stretch Animation */
  @media (min-width: 901px) {
    .nav-pill-header:hover {
      max-width: 1140px;
      box-shadow: 0 18px 44px rgba(11, 40, 69, 0.14), 0 4px 12px rgba(50, 92, 232, 0.1);
      border-color: rgba(50, 92, 232, 0.25);
    }

    .nav-pill-inner {
      transition: padding 0.45s cubic-bezier(0.22, 1, 0.36, 1), gap 0.45s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .nav-pill-header:hover .nav-pill-inner {
      padding: 0 26px 0 30px;
      gap: 26px;
    }

    .nav-links {
      transition: gap 0.45s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .nav-pill-header:hover .nav-links {
      gap: 12px;
    }
  }

  .nav-pill-inner {
    height: 64px;
    padding: 0 20px 0 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  /* Logo */
  .nav-logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .nav-logo img {
    height: 32px;
    width: auto;
    object-fit: contain;
  }

  /* Nav Items */
  .nav-links {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .nav-link,
  .nav-link-btn {
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 700;
    color: var(--pr-navy);
    padding: 8px 16px;
    border-radius: var(--radius-pill);
    background: none;
    border: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-decoration: none;
    transition: all 0.2s ease;
    user-select: none;
  }

  .nav-link:hover,
  .nav-link-btn:hover,
  .has-dropdown:hover .nav-link-btn {
    color: var(--pr-blue);
    background: rgba(50, 92, 232, 0.08);
  }

  .chevron-icon {
    transition: transform 0.25s ease;
  }

  .has-dropdown:hover .chevron-icon {
    transform: rotate(180deg);
  }

  /* Expanding Card Dropdown Panels */
  .nav-item.has-dropdown {
    position: relative;
  }

  .dropdown-panel {
    position: absolute;
    top: calc(100% + 14px);
    left: 50%;
    transform: translateX(-50%) translateY(-8px) scale(0.96);
    background: var(--pr-white);
    border: 1px solid var(--pr-border);
    border-radius: var(--radius-2xl);
    box-shadow: 0 20px 48px rgba(11, 40, 69, 0.14), 0 4px 12px rgba(11, 40, 69, 0.04);
    padding: 20px;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: all 0.25s cubic-bezier(0.25, 1, 0.5, 1);
    z-index: 1001;
  }

  .dropdown-panel::before {
    content: '';
    position: absolute;
    top: -14px;
    left: 0;
    right: 0;
    height: 14px;
  }

  .has-dropdown:hover .dropdown-panel {
    opacity: 1;
    visibility: visible;
    pointer-events: all;
    transform: translateX(-50%) translateY(0) scale(1);
  }

  /* Services Megamenu Dropdown */
  .dropdown-panel--services {
    width: 680px;
  }

  .dropdown-card-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 16px;
  }

  .dropdown-items {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .dropdown-item-card {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 12px 14px;
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .dropdown-item-card:hover {
    background: var(--pr-light-blue);
    transform: translateX(3px);
  }

  .dropdown-item-icon {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: var(--pr-chalk);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--pr-blue);
    flex-shrink: 0;
    transition: all 0.2s ease;
  }

  .dropdown-item-card:hover .dropdown-item-icon {
    background: var(--pr-blue);
    color: var(--pr-white);
  }

  .dropdown-item-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .dropdown-item-title {
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 800;
    color: var(--pr-navy);
  }

  .dropdown-item-desc {
    font-size: 12px;
    line-height: 1.4;
    color: var(--pr-text);
  }

  /* Dropdown Featured Card */
  .dropdown-featured-card {
    background: var(--pr-navy);
    border-radius: var(--radius-xl);
    padding: 20px;
    color: var(--pr-white);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
    overflow: hidden;
  }

  .dropdown-featured-card::before {
    content: '';
    position: absolute;
    top: -30%;
    right: -30%;
    width: 150px;
    height: 150px;
    background: radial-gradient(circle, rgba(50, 92, 232, 0.35) 0%, transparent 70%);
  }

  .featured-badge {
    display: inline-block;
    width: fit-content;
    padding: 3px 8px;
    background: rgba(50, 92, 232, 0.4);
    border-radius: var(--radius-pill);
    font-family: var(--font-heading);
    font-size: 10px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--pr-blue-light);
    margin-bottom: 8px;
  }

  .featured-title {
    font-size: 18px;
    font-weight: 900;
    color: var(--pr-white);
    margin-bottom: 6px;
  }

  .featured-desc {
    font-size: 12px;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 16px;
  }

  .featured-link {
    font-family: var(--font-heading);
    font-size: 12.5px;
    font-weight: 800;
    color: var(--pr-blue-light);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .featured-link:hover {
    color: var(--pr-white);
  }

  /* Resources Dropdown */
  .dropdown-panel--resources {
    width: 340px;
  }

  .dropdown-resources-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .resource-item-card {
    padding: 12px 14px;
    border-radius: var(--radius-lg);
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: 4px;
    transition: all 0.2s ease;
  }

  .resource-item-card:hover {
    background: var(--pr-light-blue);
    transform: translateX(3px);
  }

  .resource-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .resource-title {
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 800;
    color: var(--pr-navy);
  }

  .resource-badge {
    font-size: 10px;
    font-weight: 800;
    padding: 2px 6px;
    border-radius: var(--radius-pill);
    background: var(--pr-blue);
    color: var(--pr-white);
    text-transform: uppercase;
  }

  .resource-desc {
    font-size: 12px;
    line-height: 1.4;
    color: var(--pr-text);
  }

  /* Actions & CTA */
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }

  .nav-cta-btn {
    border-radius: var(--radius-pill);
  }

  /* Mobile Toggle */
  .mobile-toggle-btn {
    display: none;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--pr-chalk);
    border: 1px solid var(--pr-border);
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .mobile-toggle-btn:hover {
    background: var(--pr-light-blue);
    border-color: rgba(50, 92, 232, 0.2);
  }

  .hamburger-bar {
    position: relative;
    width: 18px;
    height: 2px;
    background: var(--pr-navy);
    border-radius: 2px;
    transition: all 0.3s ease;
  }

  .hamburger-bar::before,
  .hamburger-bar::after {
    content: '';
    position: absolute;
    left: 0;
    width: 18px;
    height: 2px;
    background: var(--pr-navy);
    border-radius: 2px;
    transition: all 0.3s ease;
  }

  .hamburger-bar::before { top: -6px; }
  .hamburger-bar::after { bottom: -6px; }

  .mobile-toggle-btn.active {
    background: var(--pr-navy);
    border-color: var(--pr-navy);
  }

  .mobile-toggle-btn.active .hamburger-bar {
    background: transparent;
  }

  .mobile-toggle-btn.active .hamburger-bar::before {
    top: 0;
    background: var(--pr-white);
    transform: rotate(45deg);
  }

  .mobile-toggle-btn.active .hamburger-bar::after {
    bottom: 0;
    background: var(--pr-white);
    transform: rotate(-45deg);
  }

  /* ========================================================
     PREMIUM MOBILE DRAWER (Clean Seamless Accordion Closure)
     ======================================================== */
  .mobile-drawer {
    display: none;
    position: absolute;
    top: calc(100% + 12px);
    left: 0;
    right: 0;
    background: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(28px);
    -webkit-backdrop-filter: blur(28px);
    border: 1px solid rgba(11, 40, 69, 0.1);
    border-radius: var(--radius-2xl);
    box-shadow: 0 24px 60px rgba(11, 40, 69, 0.18), 0 4px 12px rgba(11, 40, 69, 0.06);
    padding: 16px;
    opacity: 0;
    transform: translateY(-8px) scale(0.98);
    pointer-events: none;
    transition: all 0.3s cubic-bezier(0.25, 1, 0.5, 1);
    max-height: calc(100vh - 120px);
    overflow-y: auto;
  }

  .mobile-drawer.open {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: all;
  }

  .mobile-drawer-nav {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .mobile-nav-link {
    font-family: var(--font-heading);
    font-size: 15px;
    font-weight: 800;
    color: var(--pr-navy);
    padding: 12px 16px;
    border-radius: var(--radius-lg);
    text-decoration: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    transition: all 0.2s ease;
  }

  .mobile-nav-link:hover {
    background: var(--pr-light-blue);
    color: var(--pr-blue);
  }

  .mobile-link-badge {
    font-size: 11px;
    font-weight: 700;
    color: var(--pr-blue);
    background: var(--pr-light-blue);
    padding: 3px 8px;
    border-radius: var(--radius-pill);
  }

  /* Mobile Accordion Groups */
  .mobile-accordion-group {
    background: var(--pr-chalk);
    border: 1px solid var(--pr-border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    margin: 4px 0;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  .mobile-accordion-btn {
    width: 100%;
    padding: 14px 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: none;
    border: none;
    cursor: pointer;
    font-family: var(--font-heading);
    font-size: 15px;
    font-weight: 800;
    color: var(--pr-navy);
    text-align: left;
    transition: background-color 0.2s ease;
  }

  .mobile-accordion-label {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .mobile-chevron {
    color: var(--pr-text);
    transition: transform 0.3s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .mobile-accordion-btn.open .mobile-chevron {
    transform: rotate(180deg);
  }

  /* Body Zero-Height Seamless Transition */
  .mobile-accordion-body {
    display: grid;
    grid-template-rows: 0fr;
    overflow: hidden;
    transition: grid-template-rows 0.3s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .mobile-accordion-body.open {
    grid-template-rows: 1fr;
  }

  .mobile-services-list,
  .mobile-resources-list {
    min-height: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 0 8px 0;
    transition: padding 0.3s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .mobile-accordion-body.open .mobile-services-list,
  .mobile-accordion-body.open .mobile-resources-list {
    padding: 0 8px 12px;
  }

  /* Redesigned Mobile Service Item Card */
  .mobile-service-card {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    background: var(--pr-white);
    border: 1px solid rgba(11, 40, 69, 0.06);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .mobile-service-card:hover {
    border-color: rgba(50, 92, 232, 0.25);
    background: var(--pr-light-blue);
    transform: translateX(2px);
  }

  .mobile-svc-icon {
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background: var(--pr-light-blue);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--pr-blue);
    flex-shrink: 0;
  }

  .mobile-svc-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
  }

  .mobile-svc-title {
    font-family: var(--font-heading);
    font-size: 13.5px;
    font-weight: 800;
    color: var(--pr-navy);
    line-height: 1.3;
  }

  .mobile-svc-desc {
    font-size: 11.5px;
    color: var(--pr-text);
    line-height: 1.35;
  }

  .mobile-svc-arrow {
    font-size: 18px;
    font-weight: 800;
    color: var(--pr-blue);
    margin-left: 4px;
  }

  /* Mobile Resource Card */
  .mobile-resource-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 12px;
    background: var(--pr-white);
    border: 1px solid rgba(11, 40, 69, 0.06);
    border-radius: var(--radius-md);
    text-decoration: none;
  }

  .mobile-res-title {
    font-family: var(--font-heading);
    font-size: 13px;
    font-weight: 700;
    color: var(--pr-navy);
  }

  .mobile-res-badge {
    font-size: 10px;
    font-weight: 800;
    padding: 2px 6px;
    border-radius: var(--radius-pill);
    background: var(--pr-light-blue);
    color: var(--pr-blue);
    text-transform: uppercase;
  }

  /* Drawer Footer */
  .mobile-drawer-footer {
    margin-top: 12px;
    padding-top: 14px;
    border-top: 1px solid var(--pr-border);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .mobile-primary-cta {
    border-radius: var(--radius-pill);
  }

  .mobile-footer-tag {
    font-size: 11.5px;
    font-weight: 600;
    color: var(--pr-text);
    margin: 0;
  }

  /* Responsive Breakpoints */
  @media (max-width: 900px) {
    .nav-links,
    .nav-cta-btn {
      display: none;
    }

    .mobile-toggle-btn {
      display: flex;
    }

    .mobile-drawer {
      display: block;
    }

    .nav-pill-inner {
      padding: 0 16px;
    }
  }
</style>

<script>
  // Scroll Shadow Effect
  const header = document.getElementById('nav-header');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 20) {
      header?.classList.add('scrolled');
    } else {
      header?.classList.remove('scrolled');
    }
  });

  // Mobile Drawer Toggle
  const toggleBtn = document.getElementById('mobile-toggle-btn');
  const drawer = document.getElementById('mobile-drawer');

  toggleBtn?.addEventListener('click', () => {
    toggleBtn.classList.toggle('active');
    drawer?.classList.toggle('open');
    toggleBtn.setAttribute('aria-expanded', 
      toggleBtn.classList.contains('active') ? 'true' : 'false'
    );
  });

  // Mobile Accordion Toggles (Robust synced toggle with chevron rotation)
  const servicesBtn = document.getElementById('mobile-services-btn');
  const servicesBody = document.getElementById('mobile-services-body');
  
  servicesBtn?.addEventListener('click', () => {
    const isOpen = servicesBody?.classList.contains('open');
    if (isOpen) {
      servicesBody?.classList.remove('open');
      servicesBtn?.classList.remove('open');
      servicesBtn?.setAttribute('aria-expanded', 'false');
    } else {
      servicesBody?.classList.add('open');
      servicesBtn?.classList.add('open');
      servicesBtn?.setAttribute('aria-expanded', 'true');
    }
  });

  const resourcesBtn = document.getElementById('mobile-resources-btn');
  const resourcesBody = document.getElementById('mobile-resources-body');

  resourcesBtn?.addEventListener('click', () => {
    const isOpen = resourcesBody?.classList.contains('open');
    if (isOpen) {
      resourcesBody?.classList.remove('open');
      resourcesBtn?.classList.remove('open');
      resourcesBtn?.setAttribute('aria-expanded', 'false');
    } else {
      resourcesBody?.classList.add('open');
      resourcesBtn?.classList.add('open');
      resourcesBtn?.setAttribute('aria-expanded', 'true');
    }
  });

  // Close drawer when clicking any link
  document.querySelectorAll('.mobile-nav-link, .mobile-service-card, .mobile-resource-card, .mobile-primary-cta').forEach((link) => {
    link.addEventListener('click', () => {
      toggleBtn?.classList.remove('active');
      drawer?.classList.remove('open');
    });
  });
</script>
