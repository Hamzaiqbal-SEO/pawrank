---
interface Stat {
  value: string;
  label: string;
}

interface Props {
  stats: Stat[];
}

const { stats } = Astro.props;
---

<div class="stats-bar reveal">
  {stats.map((stat) => (
    <div class="stat-item">
      <span class="stat-value">{stat.value}</span>
      <span class="stat-label">{stat.label}</span>
    </div>
  ))}
</div>

<style>
  .stats-bar {
    display: flex;
    justify-content: center;
    gap: 64px;
    flex-wrap: wrap;
    padding: 48px 24px;
    max-width: 900px;
    margin: 0 auto;
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    text-align: center;
  }

  .stat-value {
    font-family: var(--font-heading);
    font-size: 42px;
    font-weight: 900;
    color: var(--pr-blue);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .stat-label {
    font-size: 14px;
    font-weight: 600;
    color: var(--pr-text);
    letter-spacing: 0.02em;
  }

  @media (max-width: 600px) {
    .stats-bar {
      gap: 32px;
    }

    .stat-value {
      font-size: 32px;
    }
  }
</style>
