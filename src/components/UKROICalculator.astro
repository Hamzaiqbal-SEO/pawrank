---
// UK Veterinary ROI Calculator Component
---

<section class="roi-section section section--navy" id="uk-vet-roi-calculator">
  <div class="container">
    <div class="roi-header text-center">
      <span class="eyebrow eyebrow--light">UK Veterinary Revenue Intelligence</span>
      <h2 style="color: var(--pr-white); margin-top: 16px;">Calculate Your Practice's SEO Revenue Opportunity</h2>
      <p class="text-lead text-lead--centered" style="color: var(--pr-text-light); margin-top: 12px;">
        UK pet owners spend between £10,000 and £20,000 per pet over their lifetime. Calculate how many registrations your clinic loses to corporate consolidators each month by not ranking in Google's Local 3-Pack.
      </p>
    </div>

    <div class="roi-calculator reveal">
      <div class="roi-inputs">
        <!-- Step 1: Practice Catchment -->
        <div class="roi-step">
          <span class="roi-step-badge">Step 1</span>
          <h4>Your UK Catchment</h4>
          
          <label class="roi-label" for="uk-roi-city">Practice Location / Area Size</label>
          <select id="uk-roi-city" class="roi-select">
            <option value="small">Small Town / Rural Market (under 50k pop)</option>
            <option value="mid" selected>Mid-Size Town or Borough (50k–150k pop)</option>
            <option value="large">Large City / Urban Centre (150k–500k pop)</option>
            <option value="metro">Major UK Metro (London, Manchester, Birmingham, Leeds 500k+)</option>
          </select>

          <label class="roi-label" for="uk-roi-slots">Available appointment slots per week</label>
          <input type="range" id="uk-roi-slots" min="4" max="35" value="10" class="roi-range" />
          <div class="roi-range-value"><span id="uk-roi-slots-value">10</span> open slots / week</div>
        </div>

        <!-- Step 2: Competition & Rank -->
        <div class="roi-step">
          <span class="roi-step-badge">Step 2</span>
          <h4>Local Competition</h4>
          
          <label class="roi-label" for="uk-roi-rank">Current Google Maps Visibility</label>
          <select id="uk-roi-rank" class="roi-select">
            <option value="12" selected>Invisible / Beyond Position 10 (Zero Local 3-Pack presence)</option>
            <option value="6">Middle Pack (Ranking positions 4 to 8)</option>
            <option value="3">Position 3 (Bottom of Google 3-Pack)</option>
            <option value="2">Position 2 (Just behind the market leader)</option>
          </select>

          <label class="roi-label" for="uk-roi-corporate">Corporate clinics in your 5-mile radius</label>
          <input type="range" id="uk-roi-corporate" min="1" max="8" value="3" class="roi-range" />
          <div class="roi-range-value"><span id="uk-roi-corporate-value">3</span> corporate competitors (CVS, IVC, Medivet, etc.)</div>
        </div>

        <!-- Step 3: Pet Lifetime Care Value -->
        <div class="roi-step">
          <span class="roi-step-badge">Step 3</span>
          <h4>UK Pet Lifetime Value (LTV)</h4>
          
          <label class="roi-label" for="uk-roi-ltv">Average Lifetime Value Per Pet (£)</label>
          <input type="range" id="uk-roi-ltv" min="10000" max="20000" step="500" value="14000" class="roi-range" />
          <div class="roi-range-value">£<span id="uk-roi-ltv-value">14,000</span> (PDSA UK Avg: £10k–£20k)</div>

          <label class="roi-label" for="uk-roi-annual">Estimated Annual Care Spend / Pet (£)</label>
          <input type="range" id="uk-roi-annual" min="400" max="1500" step="50" value="850" class="roi-range" />
          <div class="roi-range-value">£<span id="uk-roi-annual-value">850</span> / year per patient</div>
        </div>
      </div>

      <!-- Results Grid -->
      <div class="roi-results">
        <!-- Revenue Lost Card -->
        <div class="roi-result-card roi-result-card--loss">
          <div class="roi-card-header">
            <span class="roi-card-tag roi-card-tag--loss">Current Leakage</span>
            <h4>What You Are Losing to Corporate Competitors</h4>
          </div>
          <div class="roi-metrics">
            <div class="roi-metric">
              <span class="roi-metric-value" id="uk-roi-searches">—</span>
              <span class="roi-metric-label">Monthly local pet care searches</span>
            </div>
            <div class="roi-metric">
              <span class="roi-metric-value" id="uk-roi-clicks-lost">—</span>
              <span class="roi-metric-label">High-intent searches lost to competitors</span>
            </div>
            <div class="roi-metric">
              <span class="roi-metric-value" id="uk-roi-patients-lost">—</span>
              <span class="roi-metric-label">New client registrations lost each month</span>
            </div>
            <div class="roi-metric roi-metric--highlight">
              <span class="roi-metric-value" id="uk-roi-revenue-lost">—</span>
              <span class="roi-metric-label">Estimated annual practice revenue lost</span>
            </div>
          </div>
        </div>

        <!-- Revenue Gained Card -->
        <div class="roi-result-card roi-result-card--gain">
          <div class="roi-card-header">
            <span class="roi-card-tag roi-card-tag--gain">Growth Potential</span>
            <h4>If Your Practice Reaches Position 1–2 in Local Pack</h4>
          </div>
          <div class="roi-metrics">
            <div class="roi-metric">
              <span class="roi-metric-value" id="uk-roi-new-registrations">—</span>
              <span class="roi-metric-label">Estimated new pet registrations / month</span>
            </div>
            <div class="roi-metric">
              <span class="roi-metric-value" id="uk-roi-slots-filled">—</span>
              <span class="roi-metric-label">Empty appointment slots filled / week</span>
            </div>
            <div class="roi-metric roi-metric--highlight">
              <span class="roi-metric-value" id="uk-roi-annual-gain">—</span>
              <span class="roi-metric-label">Additional annual revenue unlocked</span>
            </div>
            <div class="roi-metric roi-metric--equity">
              <span class="roi-metric-value" id="uk-roi-equity-gain">—</span>
              <span class="roi-metric-label">Total lifetime practice value added (£10k–£20k LTV)</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Methodological Disclaimer -->
      <div class="roi-foot">
        <p class="roi-disclaimer">
          <strong>Methodology & Sources:</strong> Grounded in UK veterinary market data including the CMA Veterinary Market Study (2024–2026), PDSA Animal Wellbeing (PAW) Report (34m pets; £10k–£20k lifetime spend), and local click-through distribution rates across Google Local 3-Pack (First Page Sage / BrightLocal 2025/2026). Assumes conservative 4.8% visitor-to-client registration rate.
        </p>
        <div class="roi-cta">
          <a href="/contact-us/#calendly" class="btn btn--primary">Claim Your Free UK SEO Audit & Action Plan</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .roi-section {
    padding: 96px 24px;
    background: var(--pr-navy);
    position: relative;
    overflow: hidden;
  }

  .roi-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(50, 92, 232, 0.4), transparent);
  }

  .roi-header {
    margin-bottom: 56px;
  }

  .roi-calculator {
    max-width: 1140px;
    margin: 0 auto;
    background: rgba(18, 47, 79, 0.7);
    border: 1px solid rgba(50, 92, 232, 0.25);
    border-radius: var(--radius-2xl);
    padding: 44px;
    backdrop-filter: blur(12px);
    box-shadow: var(--shadow-navy);
  }

  .roi-inputs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
    margin-bottom: 40px;
  }

  .roi-step {
    background: rgba(11, 40, 69, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-xl);
    padding: 24px;
    display: flex;
    flex-direction: column;
    position: relative;
  }

  .roi-step-badge {
    display: inline-block;
    align-self: flex-start;
    padding: 3px 10px;
    border-radius: var(--radius-pill);
    background: rgba(50, 92, 232, 0.25);
    color: var(--pr-blue-light);
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 12px;
  }

  .roi-step h4 {
    font-size: 17px;
    color: var(--pr-white);
    margin-bottom: 18px;
    padding-bottom: 12px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .roi-label {
    font-size: 12.5px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.75);
    margin-bottom: 8px;
    margin-top: 14px;
    display: block;
  }

  .roi-select {
    width: 100%;
    padding: 10px 14px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: var(--radius-sm);
    color: var(--pr-white);
    font-family: var(--font-body);
    font-size: 13px;
    outline: none;
    transition: all var(--transition-fast);
  }

  .roi-select:focus {
    border-color: var(--pr-blue);
    background: rgba(255, 255, 255, 0.1);
  }

  .roi-select option {
    background: var(--pr-navy);
    color: var(--pr-white);
  }

  .roi-range {
    width: 100%;
    accent-color: var(--pr-blue);
    margin-top: 8px;
    cursor: pointer;
  }

  .roi-range-value {
    font-size: 12px;
    font-weight: 700;
    color: var(--pr-blue-light);
    margin-top: 6px;
    text-align: right;
  }

  /* Results section */
  .roi-results {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-bottom: 36px;
  }

  .roi-result-card {
    border-radius: var(--radius-xl);
    padding: 30px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
    border: 1px solid;
  }

  .roi-result-card--loss {
    background: rgba(243, 114, 98, 0.05);
    border-color: rgba(243, 114, 98, 0.3);
  }

  .roi-result-card--gain {
    background: rgba(119, 185, 120, 0.07);
    border-color: rgba(119, 185, 120, 0.35);
  }

  .roi-card-header {
    margin-bottom: 20px;
  }

  .roi-card-tag {
    display: inline-block;
    padding: 4px 10px;
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border-radius: var(--radius-pill);
    margin-bottom: 10px;
  }

  .roi-card-tag--loss {
    background: rgba(243, 114, 98, 0.2);
    color: #FFA599;
  }

  .roi-card-tag--gain {
    background: rgba(119, 185, 120, 0.2);
    color: #A3E7A4;
  }

  .roi-result-card h4 {
    font-size: 19px;
    color: var(--pr-white);
    line-height: 1.3;
  }

  .roi-metrics {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }

  .roi-metric {
    background: rgba(11, 40, 69, 0.5);
    border-radius: var(--radius-md);
    padding: 14px;
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .roi-metric--highlight {
    grid-column: 1 / -1;
    background: rgba(11, 40, 69, 0.85);
    border-width: 1px;
  }

  .roi-result-card--loss .roi-metric--highlight {
    border-color: rgba(243, 114, 98, 0.4);
  }

  .roi-result-card--gain .roi-metric--highlight {
    border-color: rgba(119, 185, 120, 0.4);
  }

  .roi-metric--equity {
    grid-column: 1 / -1;
    background: linear-gradient(135deg, rgba(50, 92, 232, 0.2), rgba(119, 185, 120, 0.15));
    border: 1px solid rgba(50, 92, 232, 0.4);
  }

  .roi-metric-value {
    display: block;
    font-family: var(--font-heading);
    font-size: 24px;
    font-weight: 800;
    color: var(--pr-white);
    line-height: 1.1;
  }

  .roi-metric-label {
    display: block;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.65);
    margin-top: 4px;
    line-height: 1.4;
  }

  .roi-result-card--loss .roi-metric--highlight .roi-metric-value {
    color: var(--pr-coral);
    font-size: 32px;
  }

  .roi-result-card--gain .roi-metric--highlight .roi-metric-value {
    color: var(--pr-success);
    font-size: 32px;
  }

  .roi-metric--equity .roi-metric-value {
    color: #79A3FF;
    font-size: 30px;
  }

  .roi-foot {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-top: 24px;
    margin-top: 8px;
  }

  .roi-disclaimer {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.45);
    text-align: center;
    max-width: 820px;
    margin: 0 auto 24px;
    line-height: 1.6;
  }

  .roi-disclaimer strong {
    color: rgba(255, 255, 255, 0.7);
  }

  .roi-cta {
    text-align: center;
  }

  @media (max-width: 1024px) {
    .roi-inputs {
      grid-template-columns: 1fr;
    }
    .roi-results {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .roi-calculator {
      padding: 20px;
    }
    .roi-metrics {
      grid-template-columns: 1fr;
    }
    .roi-metric--highlight .roi-metric-value {
      font-size: 26px !important;
    }
  }
</style>

<script>
  // UK Market Catchment Search Volumes
  const ukCityData: Record<string, { searches: number; label: string }> = {
    small: { searches: 1400, label: 'Small Town / Rural Market' },
    mid: { searches: 3800, label: 'Mid-Size Town or Borough' },
    large: { searches: 8500, label: 'Large City / Urban Centre' },
    metro: { searches: 22000, label: 'Major UK Metro' },
  };

  const ukConversionRate = 0.048; // ~4.8% of organic/local search visitors register as new clients

  function calculateUKROI() {
    const city = (document.getElementById('uk-roi-city') as HTMLSelectElement)?.value || 'mid';
    const slots = parseInt((document.getElementById('uk-roi-slots') as HTMLInputElement)?.value || '10');
    const currentRank = parseInt((document.getElementById('uk-roi-rank') as HTMLSelectElement)?.value || '12');
    const corporateCount = parseInt((document.getElementById('uk-roi-corporate') as HTMLInputElement)?.value || '3');
    const ltv = parseInt((document.getElementById('uk-roi-ltv') as HTMLInputElement)?.value || '14000');
    const annualSpend = parseInt((document.getElementById('uk-roi-annual') as HTMLInputElement)?.value || '850');

    // Update labels
    const slotsEl = document.getElementById('uk-roi-slots-value');
    const corpEl = document.getElementById('uk-roi-corporate-value');
    const ltvEl = document.getElementById('uk-roi-ltv-value');
    const annualEl = document.getElementById('uk-roi-annual-value');

    if (slotsEl) slotsEl.textContent = String(slots);
    if (corpEl) corpEl.textContent = String(corporateCount);
    if (ltvEl) ltvEl.textContent = ltv.toLocaleString('en-GB');
    if (annualEl) annualEl.textContent = annualSpend.toLocaleString('en-GB');

    const totalMonthlySearches = ukCityData[city]?.searches || 3800;

    // Calculate lost share based on current rank
    let lostCtrShare = 0.69;
    if (currentRank === 2) lostCtrShare = 0.398;
    else if (currentRank === 3) lostCtrShare = 0.585;
    else if (currentRank === 6) lostCtrShare = 0.694;
    else lostCtrShare = 0.76;

    const corporateBonus = Math.min(corporateCount * 0.02, 0.08);
    lostCtrShare = Math.min(lostCtrShare + corporateBonus, 0.85);

    const lostClicks = Math.round(totalMonthlySearches * lostCtrShare);
    const lostClientsMonthly = Math.max(1, Math.round(lostClicks * ukConversionRate));
    const annualRevenueLost = lostClientsMonthly * annualSpend * 12;

    // Position 1–2 Local Pack Opportunity
    const capturedClicks = Math.round(totalMonthlySearches * 0.32);
    const potentialNewClientsMonthly = Math.max(2, Math.round(capturedClicks * ukConversionRate));
    
    // Slots filled per week (capped by available practice capacity)
    const weeklyNewClients = Math.round(potentialNewClientsMonthly / 4.3);
    const slotsFilledWeekly = Math.min(weeklyNewClients, slots);

    const annualRevenueGain = potentialNewClientsMonthly * annualSpend * 12;
    const lifetimeEquityGain = (potentialNewClientsMonthly * 12) * ltv;

    // Formatting helpers
    const fmt = (n: number) => n.toLocaleString('en-GB');
    const fmtGBP = (n: number) => '£' + n.toLocaleString('en-GB');

    // DOM Updates
    const elSearches = document.getElementById('uk-roi-searches');
    const elClicksLost = document.getElementById('uk-roi-clicks-lost');
    const elPatientsLost = document.getElementById('uk-roi-patients-lost');
    const elRevLost = document.getElementById('uk-roi-revenue-lost');

    const elNewReg = document.getElementById('uk-roi-new-registrations');
    const elSlots = document.getElementById('uk-roi-slots-filled');
    const elAnnualGain = document.getElementById('uk-roi-annual-gain');
    const elEquityGain = document.getElementById('uk-roi-equity-gain');

    if (elSearches) elSearches.textContent = fmt(totalMonthlySearches);
    if (elClicksLost) elClicksLost.textContent = fmt(lostClicks);
    if (elPatientsLost) elPatientsLost.textContent = fmt(lostClientsMonthly) + ' clients/mo';
    if (elRevLost) elRevLost.textContent = fmtGBP(annualRevenueLost);

    if (elNewReg) elNewReg.textContent = '+' + fmt(potentialNewClientsMonthly) + ' pets/mo';
    if (elSlots) elSlots.textContent = fmt(slotsFilledWeekly) + ' of ' + slots + ' slots/wk';
    if (elAnnualGain) elAnnualGain.textContent = fmtGBP(annualRevenueGain);
    if (elEquityGain) elEquityGain.textContent = fmtGBP(lifetimeEquityGain);
  }

  // Bind inputs
  ['uk-roi-city', 'uk-roi-slots', 'uk-roi-rank', 'uk-roi-corporate', 'uk-roi-ltv', 'uk-roi-annual'].forEach((id) => {
    document.getElementById(id)?.addEventListener('input', calculateUKROI);
    document.getElementById(id)?.addEventListener('change', calculateUKROI);
  });

  // Calculate immediately on load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', calculateUKROI);
  } else {
    calculateUKROI();
  }
</script>
