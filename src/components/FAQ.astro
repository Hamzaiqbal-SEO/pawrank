---
interface FaqItem {
  question: string;
  answer: string;
  category?: string;
}

interface Category {
  id: string;
  label: string;
}

interface Props {
  items: FaqItem[];
  categories?: Category[];
  showCategories?: boolean;
}

const { 
  items, 
  categories: explicitCategories, 
  showCategories = true 
} = Astro.props;

// Auto-derive categories if items have category property, or provide default categorization
const defaultCategories: Category[] = [
  { id: 'all', label: 'All Questions' },
  { id: 'general', label: 'General & Strategy' },
  { id: 'pricing', label: 'Pricing & Plans' },
  { id: 'process', label: 'Process & Results' },
];

const availableCategories = explicitCategories || defaultCategories;

// Assign default category to items if not provided
const enrichedItems = items.map((item, idx) => {
  let cat = item.category;
  if (!cat) {
    const q = item.question.toLowerCase();
    if (q.includes('price') || q.includes('plan') || q.includes('fee') || q.includes('cost') || q.includes('contract') || q.includes('grow appointments') || q.includes('get found') || q.includes('switch')) {
      cat = 'pricing';
    } else if (q.includes('how long') || q.includes('result') || q.includes('measure') || q.includes('happen') || q.includes('process') || q.includes('redesign')) {
      cat = 'process';
    } else {
      cat = 'general';
    }
  }
  return { ...item, category: cat, id: `faq-item-${idx}` };
});
---

<div class="faq-block">
  <!-- Multi-Category Filter Tabs (FAQ 3 Pattern) -->
  {showCategories && (
    <div class="faq-tabs-container reveal">
      <div class="faq-tabs" role="tablist" aria-label="FAQ categories">
        {availableCategories.map((cat, idx) => (
          <button
            class={`faq-tab ${idx === 0 ? 'active' : ''}`}
            data-category={cat.id}
            role="tab"
            aria-selected={idx === 0 ? 'true' : 'false'}
          >
            <span>{cat.label}</span>
          </button>
        ))}
      </div>
    </div>
  )}

  <!-- Animated Accordions -->
  <div class="faq-accordion" id="faq-accordion-list">
    {enrichedItems.map((item, index) => (
      <div 
        class="faq-item reveal" 
        data-category={item.category} 
        data-index={index}
      >
        <button 
          class="faq-header" 
          aria-expanded="false" 
          aria-controls={`faq-body-${index}`}
          id={`faq-btn-${index}`}
        >
          <div class="faq-header-content">
            <span class="faq-category-badge">{item.category}</span>
            <span class="faq-question">{item.question}</span>
          </div>
          <div class="faq-icon-wrapper" aria-hidden="true">
            <svg class="faq-icon-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line class="faq-icon-line-v" x1="12" y1="5" x2="12" y2="19"></line>
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
          </div>
        </button>
        
        <div 
          class="faq-body" 
          id={`faq-body-${index}`} 
          role="region" 
          aria-labelledby={`faq-btn-${index}`}
        >
          <div class="faq-body-inner">
            <p set:html={item.answer} />
          </div>
        </div>
      </div>
    ))}
  </div>
</div>

<style>
  .faq-block {
    max-width: 900px;
    margin: 0 auto;
    width: 100%;
  }

  /* Multi-Category Filter Tabs */
  .faq-tabs-container {
    display: flex;
    justify-content: center;
    margin-bottom: 36px;
  }

  .faq-tabs {
    display: inline-flex;
    background: rgba(11, 40, 69, 0.04);
    padding: 6px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--pr-border);
    gap: 6px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .faq-tab {
    padding: 10px 22px;
    border-radius: var(--radius-pill);
    border: none;
    background: transparent;
    font-family: var(--font-heading);
    font-size: 13.5px;
    font-weight: 700;
    color: var(--pr-text);
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.25, 1, 0.5, 1);
    white-space: nowrap;
    position: relative;
    user-select: none;
  }

  .faq-tab:hover {
    color: var(--pr-navy);
    background: rgba(50, 92, 232, 0.08);
  }

  .faq-tab.active {
    background: var(--pr-blue);
    color: var(--pr-white);
    box-shadow: 0 4px 14px rgba(50, 92, 232, 0.3);
  }

  /* Accordion List */
  .faq-accordion {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .faq-item {
    background: var(--pr-white);
    border: 1px solid var(--pr-border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    transition: transform 0.3s cubic-bezier(0.25, 1, 0.5, 1), box-shadow 0.3s ease, border-color 0.3s ease, opacity 0.3s ease;
  }

  .faq-item:hover {
    border-color: rgba(50, 92, 232, 0.25);
    box-shadow: var(--shadow-subtle);
  }

  .faq-item.open {
    border-color: rgba(50, 92, 232, 0.35);
    box-shadow: 0 8px 30px rgba(50, 92, 232, 0.08);
  }

  .faq-item.hidden {
    display: none;
    opacity: 0;
    transform: scale(0.98);
  }

  /* Header */
  .faq-header {
    width: 100%;
    padding: 24px 28px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    cursor: pointer;
    background: none;
    border: none;
    text-align: left;
    transition: background-color 0.2s ease;
  }

  .faq-header-content {
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 1;
  }

  .faq-category-badge {
    display: inline-block;
    width: fit-content;
    font-family: var(--font-heading);
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--pr-blue);
    background: var(--pr-light-blue);
    padding: 3px 10px;
    border-radius: var(--radius-sm);
  }

  .faq-question {
    font-family: var(--font-heading);
    font-size: 17px;
    font-weight: 800;
    color: var(--pr-navy);
    line-height: 1.4;
    letter-spacing: -0.01em;
  }

  /* Icon */
  .faq-icon-wrapper {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--pr-light-blue);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: var(--pr-blue);
    transition: all 0.3s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .faq-item:hover .faq-icon-wrapper {
    background: var(--pr-blue);
    color: var(--pr-white);
  }

  .faq-item.open .faq-icon-wrapper {
    background: var(--pr-blue);
    color: var(--pr-white);
    transform: rotate(45deg);
  }

  .faq-icon-line-v {
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  /* Body */
  .faq-body {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.35s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .faq-item.open .faq-body {
    grid-template-rows: 1fr;
  }

  .faq-body-inner {
    overflow: hidden;
    padding: 0 28px;
    transition: padding 0.35s ease;
  }

  .faq-item.open .faq-body-inner {
    padding: 0 28px 24px;
  }

  .faq-body-inner p {
    font-size: 15.5px;
    line-height: 1.7;
    color: var(--pr-text);
    margin: 0;
  }

  @media (max-width: 600px) {
    .faq-tabs {
      border-radius: var(--radius-lg);
      width: 100%;
    }

    .faq-tab {
      flex: 1 1 calc(50% - 6px);
      text-align: center;
      padding: 8px 12px;
      font-size: 12px;
    }

    .faq-header {
      padding: 20px 20px;
    }

    .faq-question {
      font-size: 15px;
    }

    .faq-body-inner {
      padding: 0 20px;
    }

    .faq-item.open .faq-body-inner {
      padding: 0 20px 20px;
    }
  }
</style>

<script>
  // Tab Switching Logic
  const tabs = document.querySelectorAll('.faq-tab');
  const items = document.querySelectorAll<HTMLElement>('.faq-item');

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      tabs.forEach((t) => {
        t.classList.remove('active');
        t.setAttribute('aria-selected', 'false');
      });
      
      tab.classList.add('active');
      tab.setAttribute('aria-selected', 'true');

      const selectedCategory = tab.getAttribute('data-category');

      items.forEach((item) => {
        const itemCategory = item.getAttribute('data-category');
        if (selectedCategory === 'all' || itemCategory === selectedCategory) {
          item.classList.remove('hidden');
        } else {
          item.classList.add('hidden');
          // Also close if it was open
          item.classList.remove('open');
          item.querySelector('.faq-header')?.setAttribute('aria-expanded', 'false');
        }
      });
    });
  });

  // Accordion Toggle Logic
  document.querySelectorAll('.faq-header').forEach((header) => {
    header.addEventListener('click', () => {
      const currentItem = header.closest('.faq-item');
      const isOpen = currentItem?.classList.contains('open');

      // Optional: Close other open items
      document.querySelectorAll('.faq-item').forEach((item) => {
        if (item !== currentItem) {
          item.classList.remove('open');
          item.querySelector('.faq-header')?.setAttribute('aria-expanded', 'false');
        }
      });

      // Toggle current item
      if (isOpen) {
        currentItem?.classList.remove('open');
        header.setAttribute('aria-expanded', 'false');
      } else {
        currentItem?.classList.add('open');
        header.setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>
