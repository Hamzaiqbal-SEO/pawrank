---
import BaseLayout from './BaseLayout.astro';
import CTABanner from '../components/CTABanner.astro';

export interface TocItem {
  id: string;
  label: string;
}

export interface FAQItem {
  q: string;
  a: string;
}

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  publishDate?: string;
  modifiedDate?: string;
  readTime?: string;
  category?: string;
  authorName?: string;
  authorUrl?: string;
  toc: TocItem[];
  faqs?: FAQItem[];
  schema?: Record<string, any> | Array<Record<string, any>>;
  endCtaTitle?: string;
  endCtaSubtitle?: string;
  endCtaButtonText?: string;
  endCtaButtonLink?: string;
  ctaBannerTitle?: string;
  ctaBannerSubtitle?: string;
  renderFaqSection?: boolean;
  hideEndCta?: boolean;
  hideBottomBanner?: boolean;
}

const {
  title,
  description,
  canonical,
  ogImage = "/images/Pawrank-Logo.png",
  publishDate,
  modifiedDate,
  readTime = "20 min read",
  category = "SEO Guide",
  authorName = "Paw Rank",
  authorUrl = "https://pawrank.com",
  toc = [],
  faqs = [],
  schema,
  endCtaTitle = "Ready to Align Your Practice's SEO Signals?",
  endCtaSubtitle = "Stop losing high-intent pet owners to outdated clinics down the street. Paw Rank specializes in end-to-end veterinary SEO, signal alignment, and patient acquisition.",
  endCtaButtonText = "Book a Free SEO Consultation",
  endCtaButtonLink = "/contact-us/#calendly",
  ctaBannerTitle = "Ready to Put These Signals to Work?",
  ctaBannerSubtitle = "Book a free consultation and get a personalized signal alignment analysis for your veterinary clinic.",
  renderFaqSection = true,
  hideEndCta = false,
  hideBottomBanner = false,
} = Astro.props;

const siteUrl = "https://pawrank.com";
const canonicalUrl = canonical || new URL(Astro.url.pathname, siteUrl).href;
const cleanHeadline = title.replace(/\s*\|\s*Paw Rank$/i, '');

// 1. Article Schema
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": cleanHeadline,
  "description": description,
  "image": ogImage.startsWith("http") ? ogImage : `${siteUrl}${ogImage}`,
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalUrl
  },
  "author": {
    "@type": "Organization",
    "name": authorName,
    "url": authorUrl
  },
  "publisher": {
    "@type": "Organization",
    "name": "Paw Rank",
    "logo": {
      "@type": "ImageObject",
      "url": `${siteUrl}/images/Pawrank-Logo.png`
    }
  },
  ...(publishDate ? { "datePublished": publishDate } : {}),
  ...(modifiedDate ? { "dateModified": modifiedDate } : (publishDate ? { "dateModified": publishDate } : {}))
};

// 2. Table of Contents ItemList Schema
const tocSchema = toc && toc.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Table of Contents",
  "description": `Table of contents for ${cleanHeadline}`,
  "numberOfItems": toc.length,
  "itemListElement": toc.map((item, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": item.label,
    "item": {
      "@type": "WebPage",
      "@id": `${canonicalUrl}#${item.id}`,
      "name": item.label,
      "url": `${canonicalUrl}#${item.id}`
    }
  }))
} : null;

// 3. FAQ Schema (if FAQs provided)
const faqSchema = faqs && faqs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.a
    }
  }))
} : null;

// Combine all schemas
const combinedSchemas = [
  articleSchema,
  ...(tocSchema ? [tocSchema] : []),
  ...(faqSchema ? [faqSchema] : []),
  ...(Array.isArray(schema) ? schema : (schema ? [schema] : []))
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonicalUrl}
  ogImage={ogImage}
  schema={combinedSchemas}
>
  <!-- Reading Progress Bar -->
  <div id="reading-progress" class="reading-progress-bar" aria-hidden="true"></div>

  <!-- Article Hero -->
  <section class="article-hero">
    <div class="container container--narrow">
      <a href="/blogs/" class="back-link">← Back to Blog</a>
      {category && <span class="eyebrow eyebrow--light">{category}</span>}
      <h1>{cleanHeadline}</h1>
      <p class="article-meta">
        {publishDate && <span>Published {publishDate}</span>}
        {publishDate && readTime && <span>•</span>}
        {readTime && <span>{readTime}</span>}
        <span>•</span>
        <span>By {authorName}</span>
      </p>
    </div>
  </section>

  <!-- Article Section -->
  <section class="section section--white article-section">
    <div class="article-layout">
      <!-- Desktop Table of Contents Sidebar -->
      {toc && toc.length > 0 && (
        <aside class="toc-sidebar" id="toc">
          <div class="toc-inner">
            <h4 class="toc-title">Contents</h4>
            <nav class="toc-nav" aria-label="Table of Contents">
              {toc.map((item) => (
                <a href={`#${item.id}`} class="toc-link">{item.label}</a>
              ))}
            </nav>
          </div>
        </aside>
      )}

      <!-- Main Article Content -->
      <article class="article-content">
        <!-- Mobile Table of Contents (Collapsible Accordion) -->
        {toc && toc.length > 0 && (
          <details class="mobile-toc-accordion" id="mobile-toc">
            <summary class="mobile-toc-summary">
              <div class="mobile-toc-title-wrap">
                <svg class="mobile-toc-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="8" y1="6" x2="21" y2="6"></line>
                  <line x1="8" y1="12" x2="21" y2="12"></line>
                  <line x1="8" y1="18" x2="21" y2="18"></line>
                  <line x1="3" y1="6" x2="3.01" y2="6"></line>
                  <line x1="3" y1="12" x2="3.01" y2="12"></line>
                  <line x1="3" y1="18" x2="3.01" y2="18"></line>
                </svg>
                <span class="mobile-toc-label">Table of Contents</span>
                <span class="mobile-toc-badge">{toc.length} Sections</span>
              </div>
              <svg class="mobile-toc-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </summary>
            <nav class="mobile-toc-nav" aria-label="Mobile Table of Contents">
              {toc.map((item) => (
                <a href={`#${item.id}`} class="mobile-toc-link">
                  <span>{item.label}</span>
                  <span class="mobile-toc-arrow">→</span>
                </a>
              ))}
            </nav>
          </details>
        )}

        <!-- Slot for Blog Content -->
        <slot />

        <!-- Optional Structured FAQ Component if renderFaqSection is true -->
        {renderFaqSection && faqs && faqs.length > 0 && !Astro.slots.has('faq-content') && (
          <div id="faq" class="article-anchor">
            <h2>Frequently Asked Questions</h2>
            <div class="faq-list">
              {faqs.map((faq) => (
                <div class="faq-item">
                  <h3 class="faq-question">{faq.q}</h3>
                  <p class="faq-answer">{faq.a}</p>
                </div>
              ))}
            </div>
          </div>
        )}

        <!-- End CTA Box -->
        {!hideEndCta && (
          <div class="article-end-cta">
            <h3>{endCtaTitle}</h3>
            <p>{endCtaSubtitle}</p>
            <a href={endCtaButtonLink} class="btn btn--primary">{endCtaButtonText}</a>
          </div>
        )}
      </article>
    </div>
  </section>

  <!-- Bottom CTA Banner -->
  {!hideBottomBanner && (
    <CTABanner
      title={ctaBannerTitle}
      subtitle={ctaBannerSubtitle}
      primaryCta={{ label: "Book a Free Consultation", href: "/contact-us/#calendly" }}
      secondaryCta={{ label: "See Our Pricing", href: "/seo-pricing/" }}
    />
  )}

  <!-- Floating Back to Top Button -->
  <button id="back-to-top" class="back-to-top-btn" aria-label="Back to top" title="Back to top">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="18 15 12 9 6 15"></polyline>
    </svg>
  </button>
</BaseLayout>

<style is:global>
  /* =========================================================
     STANDARDIZED PAWRANK BLOG SYSTEM (Mobile & Desktop)
     ========================================================= */

  /* Reading Progress Bar */
  .reading-progress-bar {
    position: fixed;
    top: 0;
    left: 0;
    height: 3.5px;
    width: 0%;
    background: linear-gradient(90deg, #325CE8 0%, #79A3FF 100%);
    z-index: 999999;
    transition: width 0.1s ease-out;
  }

  /* Article Hero */
  .article-hero {
    background: var(--gradient-hero);
    padding: 150px 24px 80px;
    color: var(--pr-white);
  }

  .back-link {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.75);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 24px;
    transition: color 0.2s;
    text-decoration: none;
    font-weight: 500;
  }

  .back-link:hover { color: var(--pr-white); }

  .article-hero h1 {
    color: var(--pr-white);
    margin-top: 12px;
    font-size: clamp(28px, 4vw, 48px);
    line-height: 1.25;
    word-break: break-word;
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 16px;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.75);
  }

  /* Article Layout & Grid Containment */
  .article-section {
    padding-top: 48px;
    overflow-x: clip;
  }

  .article-layout {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: 260px minmax(0, 1fr);
    gap: 64px;
    align-items: start;
    width: 100%;
    box-sizing: border-box;
  }

  /* Desktop Table of Contents Sidebar */
  .toc-sidebar {
    position: sticky;
    top: 96px;
  }

  .toc-inner {
    background: var(--pr-chalk);
    border: 1px solid var(--pr-border);
    border-radius: var(--radius-lg);
    padding: 24px;
    max-height: calc(100vh - 120px);
    overflow-y: auto;
  }

  .toc-title {
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--pr-navy);
    margin-bottom: 16px;
  }

  .toc-nav {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .toc-link {
    font-size: 13px;
    color: var(--pr-text);
    padding: 4px 0;
    border-left: 2px solid transparent;
    padding-left: 12px;
    text-decoration: none;
    transition: all 0.2s;
    line-height: 1.4;
  }

  .toc-link:hover, .toc-link.active {
    color: var(--pr-blue);
    border-left-color: var(--pr-blue);
  }

  /* Mobile Table of Contents (Accordion) */
  .mobile-toc-accordion {
    display: none;
    background: var(--pr-white);
    border: 1px solid var(--pr-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-subtle);
    margin: 0 0 32px 0;
    overflow: hidden;
    width: 100%;
    box-sizing: border-box;
  }

  .mobile-toc-summary {
    padding: 16px 20px;
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    user-select: none;
    background: var(--pr-chalk);
    border-bottom: 1px solid transparent;
    transition: background 0.2s, border-color 0.2s;
  }

  .mobile-toc-summary::-webkit-details-marker {
    display: none;
  }

  .mobile-toc-accordion[open] .mobile-toc-summary {
    background: #EEF2FD;
    border-bottom-color: var(--pr-border);
  }

  .mobile-toc-title-wrap {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }

  .mobile-toc-icon {
    color: var(--pr-blue);
    flex-shrink: 0;
  }

  .mobile-toc-label {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 15px;
    color: var(--pr-navy);
  }

  .mobile-toc-badge {
    background: rgba(50, 92, 232, 0.1);
    color: var(--pr-blue);
    font-size: 11px;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: var(--radius-pill);
    white-space: nowrap;
  }

  .mobile-toc-chevron {
    color: var(--pr-navy);
    flex-shrink: 0;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .mobile-toc-accordion[open] .mobile-toc-chevron {
    transform: rotate(180deg);
  }

  .mobile-toc-nav {
    padding: 12px 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    max-height: 380px;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    background: var(--pr-white);
  }

  .mobile-toc-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 12px;
    font-size: 13.5px;
    line-height: 1.35;
    color: var(--pr-navy);
    text-decoration: none !important;
    border-radius: var(--radius-sm);
    background: #FAFBFD;
    border: 1px solid rgba(11, 40, 69, 0.05);
    transition: background 0.15s, color 0.15s, border-color 0.15s;
  }

  .mobile-toc-link:hover,
  .mobile-toc-link.active {
    background: #F0F4FE;
    color: var(--pr-blue);
    border-color: rgba(50, 92, 232, 0.25);
    font-weight: 600;
  }

  .mobile-toc-arrow {
    color: var(--pr-blue);
    opacity: 0.6;
    margin-left: 8px;
    flex-shrink: 0;
    font-size: 14px;
  }

  /* Article Content */
  .article-content {
    max-width: 820px;
    width: 100%;
    min-width: 0;
    box-sizing: border-box;
    overflow-wrap: break-word;
    word-break: break-word;
  }

  .article-anchor {
    scroll-margin-top: 100px;
    margin-bottom: 48px;
  }

  .article-content h2 {
    font-size: 30px;
    margin-bottom: 20px;
    padding-top: 24px;
    border-top: 1px solid var(--pr-border);
    color: var(--pr-navy);
    line-height: 1.3;
    word-break: break-word;
  }

  .article-content h2:first-of-type { border-top: none; padding-top: 0; }

  .article-content h3 {
    font-size: 21px;
    margin-top: 32px;
    margin-bottom: 14px;
    color: var(--pr-navy);
    line-height: 1.35;
    word-break: break-word;
  }

  .article-content p {
    margin-bottom: 18px;
    font-size: 16px;
    line-height: 1.75;
    color: var(--pr-text);
  }

  .article-content img {
    border-radius: var(--radius-lg);
    margin: 24px 0 8px;
    box-shadow: var(--shadow-subtle);
    width: 100%;
    max-width: 100%;
    height: auto;
    display: block;
    object-fit: contain;
  }

  .article-hero-img {
    width: 100%;
    max-width: 100%;
    margin-bottom: 40px;
  }

  .article-figure {
    margin: 28px 0;
    text-align: center;
    width: 100%;
    max-width: 100%;
  }

  .article-figure figcaption {
    font-size: 13px;
    color: var(--pr-text);
    margin-top: 8px;
    font-style: italic;
    line-height: 1.4;
    word-break: break-word;
  }

  .article-content a:not(.btn) {
    color: var(--pr-blue);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .article-content a:not(.btn):hover { color: var(--pr-blue-hover); }

  /* Callout Standard */
  .callout {
    background: var(--pr-light-blue);
    border-left: 4px solid var(--pr-blue);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    padding: 20px 24px;
    margin: 24px 0;
    font-size: 15.5px;
    line-height: 1.65;
    color: var(--pr-navy);
    font-weight: 500;
    word-break: break-word;
  }

  .callout strong { color: var(--pr-blue); }

  /* Key Takeaways Box */
  .takeaways-box {
    background: #F4F7FE;
    border: 1px solid #D2E0FB;
    border-left: 5px solid var(--pr-blue);
    border-radius: var(--radius-md);
    padding: 22px 26px;
    margin: 26px 0;
    word-break: break-word;
  }

  .box-title {
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--pr-blue);
    margin-bottom: 12px;
    margin-top: 0;
  }

  .takeaways-box ul {
    margin: 0;
    padding-left: 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .takeaways-box li {
    font-size: 15px;
    line-height: 1.6;
    color: var(--pr-navy);
  }

  /* Differentiation Opportunity Box */
  .diff-opp-box {
    background: #F2FAF5;
    border: 1px solid #C3E6D0;
    border-left: 5px solid #2E8B57;
    border-radius: var(--radius-md);
    padding: 20px 24px;
    margin: 26px 0;
    word-break: break-word;
  }

  .diff-opp-box .box-title {
    color: #2E8B57;
  }

  .diff-opp-box p {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--pr-navy);
  }

  /* Expert Tip Box */
  .expert-tip-box {
    background: #FFF9E6;
    border: 1px solid #F5E0A0;
    border-left: 5px solid #D9822B;
    border-radius: var(--radius-md);
    padding: 20px 24px;
    margin: 26px 0;
    word-break: break-word;
  }

  .expert-tip-box .box-title {
    color: #D9822B;
  }

  .expert-tip-box p {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--pr-navy);
  }

  /* Unique Content Element Box */
  .unique-element-box {
    background: #F6F3FF;
    border: 1px solid #DFD5FA;
    border-left: 5px solid #7B42BC;
    border-radius: var(--radius-md);
    padding: 20px 24px;
    margin: 26px 0;
    word-break: break-word;
  }

  .unique-element-box .box-title {
    color: #7B42BC;
  }

  .unique-element-box p {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--pr-navy);
  }

  /* Case Study Cards */
  .case-study-card {
    background: var(--pr-chalk);
    border: 1px solid var(--pr-border-dark);
    border-left: 4px solid var(--pr-navy);
    border-radius: var(--radius-md);
    padding: 22px 26px;
    margin: 24px 0;
    word-break: break-word;
  }

  .case-study-card p {
    font-size: 15px;
    line-height: 1.65;
    color: var(--pr-navy);
    margin-bottom: 12px;
  }

  .case-study-card p:last-child {
    margin-bottom: 0;
  }

  .article-case-study {
    display: grid;
    gap: 16px;
    margin: 24px 0;
  }

  .acs-block {
    padding: 20px 24px;
    background: var(--pr-chalk);
    border: 1px solid var(--pr-border);
    border-radius: var(--radius-md);
    word-break: break-word;
  }

  .acs-block h4 {
    font-size: 14px;
    color: var(--pr-blue);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 8px;
  }

  .acs-block p { margin: 0; font-size: 15px; line-height: 1.6; }

  .acs-block--highlight {
    background: var(--pr-navy);
    border-color: var(--pr-blue);
  }

  .acs-block--highlight h4 { color: var(--pr-blue-light); }
  .acs-block--highlight p { color: rgba(255, 255, 255, 0.9); }
  .acs-block--highlight strong { color: var(--pr-success); }

  /* Checklist Component */
  .checklist {
    background: var(--pr-chalk);
    border: 1px solid var(--pr-border);
    border-radius: var(--radius-lg);
    padding: 24px 28px;
    margin: 24px 0;
    word-break: break-word;
  }

  .checklist h4 {
    font-size: 16px;
    color: var(--pr-navy);
    margin-bottom: 16px;
  }

  .checklist ul {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .checklist li {
    font-size: 14.5px;
    line-height: 1.55;
    padding-left: 26px;
    position: relative;
    color: var(--pr-navy);
  }

  .checklist li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--pr-success);
    font-weight: 700;
  }

  /* Pillar Grid */
  .pillar-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
    margin: 24px 0;
  }

  .pillar-card {
    background: var(--pr-chalk);
    border: 1px solid var(--pr-border);
    border-radius: var(--radius-lg);
    padding: 20px;
    transition: all var(--transition-base);
    word-break: break-word;
  }

  .pillar-card:hover {
    border-color: rgba(50, 92, 232, 0.25);
    transform: translateY(-2px);
    box-shadow: var(--shadow-subtle);
  }

  .pillar-card h4 { font-size: 15px; margin-bottom: 8px; color: var(--pr-navy); }
  .pillar-card p { font-size: 13.5px; line-height: 1.55; margin: 0; }

  /* Priority Matrix Table & Mobile Scroll Hint */
  .table-scroll-hint {
    display: none;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 700;
    color: var(--pr-blue);
    background: var(--pr-light-blue);
    padding: 8px 14px;
    border-radius: var(--radius-sm);
    margin-bottom: 12px;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    border: 1px solid rgba(50, 92, 232, 0.15);
  }

  .table-responsive {
